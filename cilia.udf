#include <iostream>
#include <fstream>
#include <sstream>
#include <string>
#include <vector>
#include <cmath>
#include <algorithm>
#include <mpi.h>
#include "udf.hpp"

// Actuator-filament cilia model: Fulford & Blake (1986) beat shape, resistive-force-theory drag,
// Gaussian-regularised body force;
// everything is non-dimensional with the cilium length L and beat period T = 1/f.

// ---------------------------------------------------------------------------
// Case parameters: read from the [CASEDATA] section of the case's .par (see readCaseData).
// Defaults are the production values.
// ---------------------------------------------------------------------------
std::string coordinatesFile = "coordinates.txt"; // one cilium per line: x_root y_root beta
int    N_p          = 20;         // panels per cilium
dfloat slenderness  = 20.0;       // L/r, sets C_par = 2 pi/ln(L/r), C_perp = 2 C_par
dfloat epsilon      = 0.1;        // Gaussian regularisation width
dfloat rcutFactor   = 3.4;        // r_cut = rcutFactor * epsilon
// spreading blob. gauss: exp(-r^2/eps^2)/(pi^1.5 eps^3); its flow is (1 + eps^2/4 lap) S F + exp. small, an
// O(eps^2/d^3) potential-dipole error in every interaction at distance d (wall image of the own cilium, neighbours),
// which gives a first-order error in eps. gauss2: (5/2 - r^2/eps^2) x gauss = (1 - eps^2/4 lap) gauss, zero
// second moment: the flow is S F up to exponentially small terms beyond a few eps
std::string gaussianKernel = "gauss";
int kernel2 = 0;
dfloat T_ramp       = 0.01;       // startup force ramp duration
dfloat f_c          = 1.5915494;  // relaxation cut-off frequency, gamma = 2 pi f_c dt
std::string relaxScheme = "cn";  // relaxation update: cn (Crank-Nicolson, second order; default), euler (first order, older runs) or none (f = f*, i.e. f_c = inf)
dfloat f_beat       = 1.0;        // beat frequency relative to the reference f
dfloat L_c          = 1.0;        // cilium length relative to the reference L
int    diagInterval = 1;          // steps between 'time ubar |V|max vals' lines
dfloat wallPlaneZ   = 0.001;      // plane of the 'wall' line integrals, just above the wall
int    profileCilia = 0;          // 1: time the udf parts (udfSource::*, udfExecuteStep::*), with device syncs
// rod test: kinematics = rod replaces the beat by a straight rigid rod of length L_c centred at
// (x_root, y_root, rodCentreZ) along rodAxis, with virtual velocity 1 along rodVelocity (it does not move)
std::string kinematics = "fb";    // fb (Fulford-Blake beat) or rod
std::string rodAxis = "z";        // x, y or z
std::string rodVelocity = "x";    // x, y or z
dfloat rodCentreZ = 0.5;
// 1 subtracts each cilium's own free-space regularised-Stokeslet velocity from u at its panels
// (RFT's ln(L/r) already holds the filament's own flow; sampling u counts it twice, ~half the drag lost)
// 2 subtracts the self-flow of the force being computed, f = C (V - u + S f), solved per cilium as
// (I - C S) f = C (V - u): the same model to O(dt^k) (u holds the flow of the EXT force, f(t_n) + O(dt^k)),
// but the subtraction is no longer an explicit positive-feedback loop (gain C S ~ 0.9, unstable with f = f*)
int    subtractSelfFlow = 0;
// panel length and tangent. uniform: l = L_c/N_p, tangent by finite differences of the panel centres (the
// Nek5000 model; FB is not inextensible, so this integrates the drag over the beat parameter s, not arclength:
// ~8% off in net force). arclength: l_i = L_c |dxi/ds(s_i)| / N_p and the analytic tangent (midpoint rule of the
// RFT line integral over the actual curve)
std::string panelLength = "uniform";
// >0 prints one 'panel' line per panel for the first dumpPanelSteps calls of userForcing (rank 0):
// call time k i, f*, applied force sum_h c_h f_h (next solve), raw u, subtracted self-flow, V_cilia
int    dumpPanelSteps = 0;
// coupling of the panel forces and the flow. explicit: one solve per step, the force from u^n enters the
// solve through o_EXT (EXT-extrapolated; needs the relaxation filter, f = f* is unstable).
// iqn: outer correctors per step (nekRS userConvergenceCheck) with interface quasi-Newton (IQN-ILS, Degroote 2009,
// as in preCICE): F^k at x(t_{n+1}) -> solve -> f* = C (V - u^k + S F^k) -> IQN update of F, until
// |f* - F| <= couplingTol |f*|; the converged F is the implicit f = f* model (needs relaxScheme = none)
std::string couplingScheme = "explicit";
dfloat couplingTol = 1e-4;        // relative 2-norm residual |f* - F| / |f*| over all panels
int    couplingMaxIter = 50;      // correctors per step; a step that hits it is counted and the last F is kept
dfloat couplingOmega = 0.2;       // under-relaxation of the first update when there are no secant pairs yet
int    couplingReuse = 8;         // IQN-ILS(q): keep the secant pairs of the last q steps
int    couplingRestart = 0;       // > 0: a step that reaches this many correctors drops the earlier steps'
                                  // pairs and goes on with its own, which are kept ('iqnrestart' line); 0 = off
dfloat couplingFilter = 1e-3;     // QR filter: drop a secant column whose orthogonal part is < filter * its norm
bool   couplingIQN = false;
double tilePeriod = 0;           // > 0 prints 'tileasym' lines: |F - F shifted by one tile| / |F| in x and y (tiled cases, tile = 1)
int    iqnVerbose = 0;            // 1 prints the residual of every corrector ('iqnres' lines: time, corrector, |f* - F|/|f*|)
// spatial binning of the force spreading. Panels are sorted into a uniform x-y-z grid of bins (width
// ~binWidth r_cut, periodic in x and y) once per panel position; each element visits only the bins within r_cut of
// its bounding box. 0 = the brute-force loop over all panels (same result to round-off)
int    ciliaBinning = 1;
dfloat binWidth = 0.5;            // target bin width / r_cut (the bins tile the box exactly, so slightly wider)
int    binningCheck = 0;          // > 0: the first binningCheck spreads also run brute force; 'bincheck' lines
int    iqnCheck = 0;              // > 0: the first iqnCheck correctors also run the host H and MGS update; 'iqncheck' lines
int    kinematicsCheck = 0;       // > 0: the first kinematicsCheck steps (iqn) also run the host kinematics and bin sort; 'kincheck' lines
int    forcingCalls = 0;

// Derived at setup
dfloat mu_hat;                    // non-dimensional viscosity (1/Re), from [FLUID VELOCITY]
dfloat C_par, C_perp;             // RFT resistance constants
dfloat l_panel;                   // panel length l = L_c/N_p
dfloat epsinv2, rcut2, invnorm;   // Gaussian kernel constants
dfloat xmin, ymin, Lx, Ly;        // periodic box in x and y, from the mesh

// Cilia layout and force history
int N_cilia = 0;
int N_part = 0;                   // total panels, N_cilia * N_p
std::vector<dfloat> xc, yc, beta_c;
std::vector<dfloat> f_old;        // relaxed panel forces from the previous step
std::vector<dfloat> fstar_old;    // unrelaxed panel forces f* from the previous step (cn only)
// self-flow: nekRS extrapolates the udf source (o_EXT) with the EXT coefficients, so the u sampled now was
// driven by sum_i c_i f_i, f_i = the forces of the last calls (i = 0 newest), spread at positions x_i
std::vector<std::vector<dfloat>> f_hist, x_hist;   // empty until the first step
std::vector<dfloat> c_hist;       // EXT coefficients of the step that produced u
bool relaxCN = false;
bool relaxNone = false;          // no relaxation, f = f*
bool restoreForceHistory = false;
const std::string forceHistoryFile = "cilia_force_history.bin";

// Fulford & Blake (1986) Fourier coefficients of the beat shape.
// Stored column by column: entry [n*3 + (m-1)] is the s^m coefficient of harmonic n.
// A1/B1 give xi_1 (along the beat direction), A2/B2 give xi_2 (wall-normal).
const int N_o = 6;
const dfloat A1[21] = {-0.449,-0.072,0.658, 0.130,-1.502,0.793, -0.169,0.260,-0.251, 0.063,-0.123,0.049, -0.050,0.011,0.009, -0.040,-0.009,0.023, -0.068,0.196,-0.111};
const dfloat A2[21] = {2.076,-1.074,0.381, -0.003,-0.230,0.331, 0.054,-0.305,0.193, 0.007,-0.180,0.082, 0.026,-0.069,0.029, 0.022,0.001,0.002, 0.010,-0.080,0.048};
const dfloat B1[18] = {-0.030,1.285,-1.034, -0.093,-0.036,0.050, 0.037,-0.244,0.143, 0.062,-0.093,0.043, 0.016,-0.137,0.098, -0.065,0.095,-0.054};
const dfloat B2[18] = {0.080,-0.298,0.210, -0.044,0.513,-0.367, -0.017,0.004,0.009, 0.052,-0.222,0.120, 0.007,0.035,-0.024, 0.051,-0.128,0.102};

// a_n(s) or b_n(s) = sum_{m=1..3} C_mn s^m; col is 1-based (col 1 = n=0 for A, n=1 for B)
dfloat coeff(const dfloat* C, int col, dfloat s) {
    int c = col - 1;
    return C[c*3 + 0]*s + C[c*3 + 1]*s*s + C[c*3 + 2]*s*s*s;
}
// d/ds of coeff
dfloat dcoeff(const dfloat* C, int col, dfloat s) {
    int c = col - 1;
    return C[c*3 + 0] + 2.0*C[c*3 + 1]*s + 3.0*C[c*3 + 2]*s*s;
}

// OCCA Device Buffers
// iqn path: o_xpc, o_V, o_TL, o_px.. and o_fl hold the LOCAL panels (own + halo cilia, localCilia order: the
// kinematics, the bins and the spreading); o_xo, o_Vo, o_TLo, o_pxo.., o_upc and o_f hold the OWN panels (find / eval,
// the panel force and the IQN iterate). Explicit coupling: one layout, all panels (o_xpc, o_f, o_px.., o_upc)
occa::memory o_xpc, o_f;
occa::memory o_V, o_TL;          // panel velocities and t, l on the device (computed there)
occa::memory o_px, o_py, o_pz, o_upc;
occa::memory o_fl;               // F of the local panels (own scattered in, halo received)
int kinPanels = 0;              // local panels in the iqn layout (kinCilia x N_p)
occa::memory o_xo, o_Vo, o_TLo, o_pxo, o_pyo, o_pzo;   // the own panels' kinematics
pointInterpolation_t* interp = nullptr;

// Profiling: tags print in the runtime statistics via addUserStat. The device is synced at each
// boundary so every part gets its own time; off by default because the syncs cost latency.
void ptic(const std::string &tag) {
  if (!profileCilia) return;
  platform->device.finish();
  platform->timer.tic(tag);
}
void ptoc(const std::string &tag) {
  if (!profileCilia) return;
  platform->device.finish();
  platform->timer.toc(tag);
}

#ifdef __okl__
@kernel void addCiliaForce(const dlong Nelements,
                           const dlong fieldOffset,
                           const int N_part,
                           @restrict const dfloat *xpc,
                           @restrict const dfloat *fpanel,
                           const dfloat epsinv2,
                           const dfloat rcut2,
                           const dfloat invnorm,
                           const int kernel2,
                           const dfloat Lx,
                           const dfloat Ly,
                           @restrict const dfloat *x,
                           @restrict const dfloat *y,
                           @restrict const dfloat *z,
                           const int useJw,
                           @restrict const dfloat *Jw,
                           const int fuse,
                           const dfloat *FU0,
                           @restrict dfloat *FU) {

  for(dlong e=0; e<Nelements; ++e; @outer(0)){
    for(int n=0; n<p_Np; ++n; @inner(0)){
      const dlong id = e*p_Np + n;
      dfloat px = x[id], py = y[id], pz = z[id];

      dfloat fx = 0.0, fy = 0.0, fz = 0.0;

      for(int i=0; i<N_part; ++i){
        // Truncate the Gaussian at r_cut, rejecting one direction at a time
        dfloat dy = py - xpc[i*3 + 1];
        dy -= Ly * floor(dy / Ly + 0.5);  // minimum image: the box is periodic in x and y
        dfloat dy2 = dy * dy;
        if (dy2 >= rcut2) continue;

        dfloat dx = px - xpc[i*3 + 0];
        dx -= Lx * floor(dx / Lx + 0.5);
        dfloat dx2 = dx * dx;
        dfloat rem = rcut2 - dy2;
        if (dx2 >= rem) continue;

        dfloat dz = pz - xpc[i*3 + 2];
        dfloat dz2 = dz * dz;
        rem = rem - dx2;
        if (dz2 >= rem) continue;

        dfloat r2 = dx2 + dy2 + dz2;
        dfloat delta = exp(-r2 * epsinv2) * invnorm;
        if (kernel2) delta *= 2.5 - r2 * epsinv2;   // gauss2

        fx += fpanel[i*3 + 0] * delta;
        fy += fpanel[i*3 + 1] * delta;
        fz += fpanel[i*3 + 2] * delta;
      }

      // iqn: FU is o_JwF (the assembled rhs), which holds the mass matrix Jw times the force
      if (useJw) {
        const dfloat w = Jw[id];
        fx *= w; fy *= w; fz *= w;
      }

      // fuse: FU = FU0 + force (the corrector's o_JwF from the step's cilia-free o_JwF0, no copy first)
      const dfloat b0 = fuse ? FU0[id + 0 * fieldOffset] : FU[id + 0 * fieldOffset];
      const dfloat b1 = fuse ? FU0[id + 1 * fieldOffset] : FU[id + 1 * fieldOffset];
      const dfloat b2 = fuse ? FU0[id + 2 * fieldOffset] : FU[id + 2 * fieldOffset];
      FU[id + 0 * fieldOffset] = b0 + fx;
      FU[id + 1 * fieldOffset] = b1 + fy;
      FU[id + 2 * fieldOffset] = b2 + fz;
    }
  }
}

// the same spreading, but element e visits only the panels in its bins. elemBins[e*6 + 0..5] = first x bin,
// number of x bins (wrapping, < nbx or = nbx from 0), first y bin, number of y bins, first and last z bin.
// Bin b = (iz nby + iy) nbx + ix holds the panels binPanel[binStart[b] .. binStart[b+1]); x bins of one (iy, iz)
// row are contiguous, so a row is at most two panel ranges (two when the x range wraps)
@kernel void addCiliaForceBinned(const dlong Nelements,
                                 const dlong fieldOffset,
                                 const int nbx,
                                 const int nby,
                                 @restrict const int *elemBins,
                                 @restrict const int *binStart,
                                 @restrict const int *binPanel,
                                 @restrict const dfloat *xpc,
                                 @restrict const dfloat *fpanel,
                                 const dfloat epsinv2,
                                 const dfloat rcut2,
                                 const dfloat invnorm,
                                 const int kernel2,
                                 const dfloat Lx,
                                 const dfloat Ly,
                                 @restrict const dfloat *x,
                                 @restrict const dfloat *y,
                                 @restrict const dfloat *z,
                                 const int useJw,
                                 @restrict const dfloat *Jw,
                                 const int fuse,
                                 const dfloat *FU0,
                                 @restrict dfloat *FU) {

  for(dlong e=0; e<Nelements; ++e; @outer(0)){
    for(int n=0; n<p_Np; ++n; @inner(0)){
      const dlong id = e*p_Np + n;
      const dfloat px = x[id], py = y[id], pz = z[id];
      const int ix0 = elemBins[e*6 + 0], nx = elemBins[e*6 + 1];
      const int iy0 = elemBins[e*6 + 2], ny = elemBins[e*6 + 3];
      const int iz0 = elemBins[e*6 + 4], iz1 = elemBins[e*6 + 5];

      dfloat fx = 0.0, fy = 0.0, fz = 0.0;

      for(int iz=iz0; iz<=iz1; ++iz){
        for(int jy=0; jy<ny; ++jy){
          int iy = iy0 + jy;
          if (iy >= nby) iy -= nby;
          const int row = (iz*nby + iy)*nbx;
          for(int seg=0; seg<2; ++seg){
            const int b0 = (seg == 0) ? ix0 : 0;
            const int b1 = (seg == 0) ? min(ix0 + nx, nbx) : ix0 + nx - nbx;   // exclusive
            if (b1 <= b0) continue;
            const int j1 = binStart[row + b1];
            for(int j=binStart[row + b0]; j<j1; ++j){
              const int i = binPanel[j];
              dfloat dy = py - xpc[i*3 + 1];
              dy -= Ly * floor(dy / Ly + 0.5);
              dfloat dy2 = dy * dy;
              if (dy2 >= rcut2) continue;

              dfloat dx = px - xpc[i*3 + 0];
              dx -= Lx * floor(dx / Lx + 0.5);
              dfloat dx2 = dx * dx;
              dfloat rem = rcut2 - dy2;
              if (dx2 >= rem) continue;

              dfloat dz = pz - xpc[i*3 + 2];
              dfloat dz2 = dz * dz;
              rem = rem - dx2;
              if (dz2 >= rem) continue;

              dfloat r2 = dx2 + dy2 + dz2;
              dfloat delta = exp(-r2 * epsinv2) * invnorm;
              if (kernel2) delta *= 2.5 - r2 * epsinv2;

              fx += fpanel[i*3 + 0] * delta;
              fy += fpanel[i*3 + 1] * delta;
              fz += fpanel[i*3 + 2] * delta;
            }
          }
        }
      }

      if (useJw) {
        const dfloat w = Jw[id];
        fx *= w; fy *= w; fz *= w;
      }

      // fuse: FU = FU0 + force (the corrector's o_JwF from the step's cilia-free o_JwF0, no copy first)
      const dfloat b0 = fuse ? FU0[id + 0 * fieldOffset] : FU[id + 0 * fieldOffset];
      const dfloat b1 = fuse ? FU0[id + 1 * fieldOffset] : FU[id + 1 * fieldOffset];
      const dfloat b2 = fuse ? FU0[id + 2 * fieldOffset] : FU[id + 2 * fieldOffset];
      FU[id + 0 * fieldOffset] = b0 + fx;
      FU[id + 1 * fieldOffset] = b1 + fy;
      FU[id + 2 * fieldOffset] = b2 + fz;
    }
  }
}

// ---------------------------------------------------------------------------
// the iqn corrector on the device. Per panel ii (one thread): u from eval (-999 in all three = lost), minus
// the own cilium's free-space regularised-Stokeslet flow of F (subtractSelfFlow 1, same formula as regStokeslet),
// then H = R mu l (C_par V_par + C_perp V_perp), V = V_cilia - u (0 when lost). H goes to pool[oH + 3 ii + c]
// ---------------------------------------------------------------------------
@kernel void ciliaPanelForce(const int N_part,
                             const int N_p,
                             @restrict const dfloat *xpc,
                             @restrict const dfloat *Vc,
                             @restrict const dfloat *TL,
                             @restrict const dfloat *upc,
                             @restrict const dfloat *F,
                             const int selfFlow,
                             const dfloat R,
                             const dfloat mu,
                             const dfloat Cpar,
                             const dfloat Cperp,
                             const dfloat eps,
                             const int kernel2,
                             const dfloat pi,
                             const dlong oH,
                             @restrict dfloat *pool) {
  for(int b=0; b<(N_part + 63)/64; ++b; @outer(0)){
    for(int t=0; t<64; ++t; @inner(0)){
      const int ii = b*64 + t;
      if (ii < N_part) {
        dfloat ux = upc[ii], uy = upc[ii + N_part], uz = upc[ii + 2*N_part];
        dfloat hx = 0.0, hy = 0.0, hz = 0.0;
        if (ux != -999.0 || uy != -999.0 || uz != -999.0) {
          if (selfFlow) {
            const int k0 = (ii / N_p) * N_p;
            dfloat us0 = 0.0, us1 = 0.0, us2 = 0.0;
            for(int j=0; j<N_p; ++j){
              const int jj = k0 + j;
              const dfloat d0 = xpc[ii*3 + 0] - xpc[jj*3 + 0];
              const dfloat d1 = xpc[ii*3 + 1] - xpc[jj*3 + 1];
              const dfloat d2 = xpc[ii*3 + 2] - xpc[jj*3 + 2];
              const dfloat r = sqrt(d0*d0 + d1*d1 + d2*d2);
              dfloat a, bb;
              if (r < 1e-3 * eps) {
                a = (kernel2 ? 1.5 : 1.0) / (3.0 * pow(pi, 1.5) * eps);
                bb = 0.0;
              } else {
                const dfloat E = erf(r / eps), ex = exp(-r * r / (eps * eps));
                dfloat G = E / (4.0 * pi * r);
                dfloat Bp = ((0.5 * r * r - 0.25 * eps * eps) * E + eps * r * ex / (2.0 * sqrt(pi))) / (4.0 * pi * r * r);
                if (kernel2) {
                  const dfloat Gp = (2.0 * r * ex / (sqrt(pi) * eps) - E) / (4.0 * pi * r * r);
                  G += 0.25 * ex / (pow(pi, 1.5) * eps);
                  Bp -= 0.25 * eps * eps * Gp;
                }
                a = G - Bp / r;
                bb = 3.0 * Bp / r - G;
              }
              const dfloat f0 = F[jj*3 + 0], f1 = F[jj*3 + 1], f2 = F[jj*3 + 2];
              const dfloat Fdotd = f0*d0 + f1*d1 + f2*d2;
              const dfloat s = (r > 0) ? bb * Fdotd / (r * r) : 0.0;
              us0 += a * f0 + s * d0;
              us1 += a * f1 + s * d1;
              us2 += a * f2 + s * d2;
            }
            ux -= us0 / mu; uy -= us1 / mu; uz -= us2 / mu;
          }
          const dfloat Vx = Vc[ii*3 + 0] - ux, Vy = Vc[ii*3 + 1] - uy, Vz = Vc[ii*3 + 2] - uz;
          const dfloat tx = TL[ii*4 + 0], ty = TL[ii*4 + 1], tz = TL[ii*4 + 2];
          const dfloat Vdt = Vx*tx + Vy*ty + Vz*tz;
          const dfloat Vpx = Vdt * tx, Vpy = Vdt * ty, Vpz = Vdt * tz;
          const dfloat scale = R * mu * TL[ii*4 + 3];
          hx = scale * (Cpar*Vpx + Cperp*(Vx - Vpx));
          hy = scale * (Cpar*Vpy + Cperp*(Vy - Vpy));
          hz = scale * (Cpar*Vpz + Cperp*(Vz - Vpz));
        }
        pool[oH + ii*3 + 0] = hx;
        pool[oH + ii*3 + 1] = hy;
        pool[oH + ii*3 + 2] = hz;
      }
    }
  }
}

// r = H - F; with a new secant pair also dR = r - r_prev, dX = H - H_prev (all n-vectors in the pool, o* = slot n)
@kernel void iqnResidual(const int n,
                         const int doPair,
                         const dlong oH,
                         const dlong oR,
                         const dlong oHp,
                         const dlong oRp,
                         const dlong oDR,
                         const dlong oDX,
                         @restrict const dfloat *F,
                         @restrict dfloat *pool) {
  for(int b=0; b<(n + 255)/256; ++b; @outer(0)){
    for(int t=0; t<256; ++t; @inner(0)){
      const int m = b*256 + t;
      if (m < n) {
        const dfloat h = pool[oH + m];
        const dfloat r = h - F[m];
        pool[oR + m] = r;
        if (doPair) {
          pool[oDR + m] = r - pool[oRp + m];
          pool[oDX + m] = h - pool[oHp + m];
        }
      }
    }
  }
}

// Dot products of pool slot pairs (pa[p], pb[p]), each split into nChunk ranges: part[p nChunk + c]
// (the host sums the chunks in order, so the result is deterministic)
@kernel void iqnPoolDots(const int n,
                         const int nPairs,
                         const int nChunk,
                         @restrict const int *pa,
                         @restrict const int *pb,
                         @restrict const dfloat *pool,
                         @restrict dfloat *part) {
  for(int p=0; p<nPairs; ++p; @outer(1)){
    for(int c=0; c<nChunk; ++c; @outer(0)){
      @shared dfloat s[256];
      for(int t=0; t<256; ++t; @inner(0)){
        const dlong oa = (dlong)pa[p] * n, ob = (dlong)pb[p] * n;
        const int len = (n + nChunk - 1) / nChunk;
        const int m0 = c * len;
        const int m1 = (m0 + len < n) ? m0 + len : n;
        dfloat acc = 0.0;
        for(int m=m0 + t; m<m1; m+=256) acc += pool[oa + m] * pool[ob + m];
        s[t] = acc;
      }
      @barrier();
      for(int t=0; t<256; ++t; @inner(0)){ if (t < 128) s[t] += s[t + 128]; }
      @barrier();
      for(int t=0; t<256; ++t; @inner(0)){ if (t < 64) s[t] += s[t + 64]; }
      @barrier();
      for(int t=0; t<256; ++t; @inner(0)){ if (t < 32) s[t] += s[t + 32]; }
      @barrier();
      for(int t=0; t<256; ++t; @inner(0)){ if (t < 16) s[t] += s[t + 16]; }
      @barrier();
      for(int t=0; t<256; ++t; @inner(0)){ if (t < 8) s[t] += s[t + 8]; }
      @barrier();
      for(int t=0; t<256; ++t; @inner(0)){ if (t < 4) s[t] += s[t + 4]; }
      @barrier();
      for(int t=0; t<256; ++t; @inner(0)){ if (t < 2) s[t] += s[t + 2]; }
      @barrier();
      for(int t=0; t<256; ++t; @inner(0)){ if (t == 0) part[p*nChunk + c] = s[0] + s[1]; }
    }
  }
}

// out = a0 base + sum_j coef[j] pool[slot j]; base = pool slot oBase, or out itself when oBase < 0 (not read if a0 = 0)
@kernel void iqnCombine(const int n,
                        const dfloat a0,
                        const dlong oBase,
                        const int q,
                        @restrict const int *slots,
                        @restrict const dfloat *coef,
                        @restrict const dfloat *pool,
                        dfloat *out) {
  for(int b=0; b<(n + 255)/256; ++b; @outer(0)){
    for(int t=0; t<256; ++t; @inner(0)){
      const int m = b*256 + t;
      if (m < n) {
        dfloat v = 0.0;
        if (a0 != 0.0) v = a0 * ((oBase >= 0) ? pool[oBase + m] : out[m]);
        for(int j=0; j<q; ++j) v += coef[j] * pool[(dlong)slots[j] * n + m];
        out[m] = v;
      }
    }
  }
}

// ---------------------------------------------------------------------------
// panel kinematics on the device, the same formulas as panelKinematics, for nPanel = N_p x (the cilia in
// root[]: x, y, beta per cilium). coef = A1[21] A2[21] B1[18] B2[18]. Uniform panels: the centred-difference
// tangent recomputes the neighbours' positions in the same thread.
// ---------------------------------------------------------------------------
@kernel void ciliaKinematics(const int nPanel,
                             const int N_p,
                             const int N_o,
                             const int rod,
                             const int arclength,
                             const dfloat tNow,
                             const dfloat omega,
                             const dfloat L_c,
                             const dfloat l_panel,
                             const int rodAx,
                             const int rodVel,
                             const dfloat rodZ,
                             const dfloat xmin,
                             const dfloat ymin,
                             const dfloat Lx,
                             const dfloat Ly,
                             @restrict const dfloat *root,
                             @restrict const dfloat *coef,
                             @restrict dfloat *xpc,
                             @restrict dfloat *Vc,
                             @restrict dfloat *TL,
                             @restrict dfloat *px,
                             @restrict dfloat *py,
                             @restrict dfloat *pz) {
  for(int b=0; b<(nPanel + 63)/64; ++b; @outer(0)){
    for(int t=0; t<64; ++t; @inner(0)){
      const int m = b*64 + t;
      if (m < nPanel) {
        const int kk = m / N_p, i = m - kk*N_p;
        const dfloat x0 = root[kk*3 + 0], y0 = root[kk*3 + 1], beta = root[kk*3 + 2];
        dfloat X0 = 0.0, X1 = 0.0, X2 = 0.0;
        if (rod) {
          const dfloat s = (dfloat)(i + 0.5) / (dfloat)N_p;
          X0 = x0 + (rodAx == 0 ? (s - 0.5) * L_c : 0.0);
          X1 = y0 + (rodAx == 1 ? (s - 0.5) * L_c : 0.0);
          X2 = rodZ + (rodAx == 2 ? (s - 0.5) * L_c : 0.0);
          xpc[m*3 + 0] = X0; xpc[m*3 + 1] = X1; xpc[m*3 + 2] = X2;
          Vc[m*3 + 0] = rodVel == 0 ? 1.0 : 0.0;
          Vc[m*3 + 1] = rodVel == 1 ? 1.0 : 0.0;
          Vc[m*3 + 2] = rodVel == 2 ? 1.0 : 0.0;
          TL[m*4 + 0] = rodAx == 0 ? 1.0 : 0.0;
          TL[m*4 + 1] = rodAx == 1 ? 1.0 : 0.0;
          TL[m*4 + 2] = rodAx == 2 ? 1.0 : 0.0;
          TL[m*4 + 3] = l_panel;
        } else {
          const dfloat cb = cos(beta), sb = sin(beta);
          // o = 0, 1, 2: panels i-1, i, i+1 (the ends use themselves; arclength needs only i)
          dfloat P0[3], P1[3], P2[3];
          for(int o=0; o<3; ++o){
            int ii = i + o - 1;
            if (ii < 0) ii = 0;
            if (ii > N_p - 1) ii = N_p - 1;
            P0[o] = 0.0; P1[o] = 0.0; P2[o] = 0.0;
            if (o != 1 && arclength) continue;
            const dfloat s = (dfloat)(ii + 0.5) / (dfloat)N_p;
            dfloat xi1 = 0.5 * (coef[0]*s + coef[1]*s*s + coef[2]*s*s*s);
            dfloat xi2 = 0.5 * (coef[21]*s + coef[22]*s*s + coef[23]*s*s*s);
            dfloat dxi1 = 0.0, dxi2 = 0.0;
            dfloat sxi1 = 0.5 * (coef[0] + 2.0*coef[1]*s + 3.0*coef[2]*s*s);
            dfloat sxi2 = 0.5 * (coef[21] + 2.0*coef[22]*s + 3.0*coef[23]*s*s);
            for(int j=1; j<=N_o; ++j){
              const dfloat wt = j * omega * tNow;
              const dfloat cw = cos(wt), sw = sin(wt);
              const int a = j*3, bb = (j - 1)*3;
              const dfloat a1 = coef[a]*s + coef[a + 1]*s*s + coef[a + 2]*s*s*s;
              const dfloat a2 = coef[21 + a]*s + coef[21 + a + 1]*s*s + coef[21 + a + 2]*s*s*s;
              const dfloat b1 = coef[42 + bb]*s + coef[42 + bb + 1]*s*s + coef[42 + bb + 2]*s*s*s;
              const dfloat b2 = coef[60 + bb]*s + coef[60 + bb + 1]*s*s + coef[60 + bb + 2]*s*s*s;
              xi1 += a1*cw + b1*sw;
              dxi1 -= (j*omega)*a1*sw - (j*omega)*b1*cw;
              xi2 += a2*cw + b2*sw;
              dxi2 -= (j*omega)*a2*sw - (j*omega)*b2*cw;
              sxi1 += (coef[a] + 2.0*coef[a + 1]*s + 3.0*coef[a + 2]*s*s)*cw
                    + (coef[42 + bb] + 2.0*coef[42 + bb + 1]*s + 3.0*coef[42 + bb + 2]*s*s)*sw;
              sxi2 += (coef[21 + a] + 2.0*coef[21 + a + 1]*s + 3.0*coef[21 + a + 2]*s*s)*cw
                    + (coef[60 + bb] + 2.0*coef[60 + bb + 1]*s + 3.0*coef[60 + bb + 2]*s*s)*sw;
            }
            P0[o] = L_c * xi1 * cb + x0;
            P1[o] = L_c * xi1 * sb + y0;
            P2[o] = L_c * xi2;
            if (o == 1) {
              Vc[m*3 + 0] = L_c * dxi1 * cb;
              Vc[m*3 + 1] = L_c * dxi1 * sb;
              Vc[m*3 + 2] = L_c * dxi2;
              if (arclength) {
                const dfloat sn = sqrt(sxi1 * sxi1 + sxi2 * sxi2);
                TL[m*4 + 0] = sxi1 * cb / sn;
                TL[m*4 + 1] = sxi1 * sb / sn;
                TL[m*4 + 2] = sxi2 / sn;
                TL[m*4 + 3] = L_c * sn / N_p;
              }
            }
          }
          X0 = P0[1]; X1 = P1[1]; X2 = P2[1];
          xpc[m*3 + 0] = X0; xpc[m*3 + 1] = X1; xpc[m*3 + 2] = X2;
          if (!arclength) {
            const dfloat t0 = P0[2] - P0[0], t1 = P1[2] - P1[0], t2 = P2[2] - P2[0];
            const dfloat tn = sqrt(t0*t0 + t1*t1 + t2*t2);
            TL[m*4 + 0] = tn > 1.0e-14 ? t0 / tn : 0.0;
            TL[m*4 + 1] = tn > 1.0e-14 ? t1 / tn : 0.0;
            TL[m*4 + 2] = tn > 1.0e-14 ? t2 / tn : 0.0;
            TL[m*4 + 3] = l_panel;
          }
        }
        px[m] = X0 - Lx * floor((X0 - xmin) / Lx);
        py[m] = X1 - Ly * floor((X1 - ymin) / Ly);
        pz[m] = X2;
      }
    }
  }
}

// stable binning on the device, no atomics. One thread per x-y bin column c owns the nbz bins
// iz nCol + c. It walks the static candidate list of the column (colCilia[colStart[c] .. colStart[c+1]): every
// cilium whose beat footprint touches c, ascending) panel by panel, so each bin's panels come out in index order:
// the host counting sort's order. Pass 0 counts into cnt, ciliaBinScan turns the counts into start, pass 1 places.
@kernel void ciliaBinColumns(const int pass,
                             const int nCol,
                             const int nbx,
                             const int nby,
                             const int nbz,
                             const int N_p,
                             const dfloat xmin,
                             const dfloat ymin,
                             const dfloat zlo,
                             const dfloat hbx,
                             const dfloat hby,
                             const dfloat hbz,
                             @restrict const int *colStart,
                             @restrict const int *colCilia,
                             @restrict const dfloat *px,
                             @restrict const dfloat *py,
                             @restrict const dfloat *pz,
                             @restrict const int *start,
                             @restrict int *cnt,
                             @restrict int *binPanel) {
  for(int b=0; b<(nCol + 63)/64; ++b; @outer(0)){
    for(int t=0; t<64; ++t; @inner(0)){
      const int c = b*64 + t;
      if (c < nCol) {
        for(int iz=0; iz<nbz; ++iz) cnt[iz*nCol + c] = (pass == 0) ? 0 : start[iz*nCol + c];
        for(int j=colStart[c]; j<colStart[c + 1]; ++j){
          const int m0 = colCilia[j] * N_p;
          for(int i=0; i<N_p; ++i){
            const int m = m0 + i;
            int ix = (int)floor((px[m] - xmin) / hbx);
            int iy = (int)floor((py[m] - ymin) / hby);
            ix = ix < 0 ? 0 : (ix > nbx - 1 ? nbx - 1 : ix);
            iy = iy < 0 ? 0 : (iy > nby - 1 ? nby - 1 : iy);
            if (iy*nbx + ix != c) continue;
            int iz = (int)floor((pz[m] - zlo) / hbz);
            iz = iz < 0 ? 0 : (iz > nbz - 1 ? nbz - 1 : iz);
            const int bin = iz*nCol + c;
            if (pass == 0) cnt[bin] += 1;
            else { binPanel[cnt[bin]] = m; cnt[bin] += 1; }
          }
        }
      }
    }
  }
}

// Exclusive scan of cnt[0 .. nb) into start[0 .. nb], one block of 256 threads (each a contiguous range).
// Every panel lies in its cilium's footprint, so start[nb] = nPanel; lost[0] accumulates any shortfall
@kernel void ciliaBinScan(const int nb,
                          const int nPanel,
                          @restrict const int *cnt,
                          @restrict int *start,
                          @restrict int *lost) {
  for(int o=0; o<1; ++o; @outer(0)){
    @shared int s[256];
    for(int t=0; t<256; ++t; @inner(0)){
      const int len = (nb + 255) / 256;
      const int b0 = t * len;
      const int b1 = (b0 + len < nb) ? b0 + len : nb;
      int acc = 0;
      for(int bb=b0; bb<b1; ++bb) acc += cnt[bb];
      s[t] = acc;
    }
    @barrier();
    for(int t=0; t<256; ++t; @inner(0)){
      if (t == 0) {
        int acc = 0;
        for(int j=0; j<256; ++j){ const int v = s[j]; s[j] = acc; acc += v; }
        start[nb] = acc;
        lost[0] += nPanel - acc;
      }
    }
    @barrier();
    for(int t=0; t<256; ++t; @inner(0)){
      const int len = (nb + 255) / 256;
      const int b0 = t * len;
      const int b1 = (b0 + len < nb) ? b0 + len : nb;
      int acc = s[t];
      for(int bb=b0; bb<b1; ++bb){ start[bb] = acc; acc += cnt[bb]; }
    }
  }
}

// copy whole blocks (w dfloats: the entries of one cilium) between layouts. Gather: dst block i = src block
// idx[i]; scatter: dst block idx[i] = src block i. Own <-> local cilia, and the halo send / receive buffers
@kernel void ciliaGatherBlocks(const int nBlk,
                               const int w,
                               @restrict const int *idx,
                               @restrict const dfloat *src,
                               @restrict dfloat *dst) {
  for(int b=0; b<(nBlk*w + 255)/256; ++b; @outer(0)){
    for(int t=0; t<256; ++t; @inner(0)){
      const int m = b*256 + t;
      if (m < nBlk*w) {
        const int i = m / w;
        dst[m] = src[(dlong)idx[i]*w + (m - i*w)];
      }
    }
  }
}

@kernel void ciliaScatterBlocks(const int nBlk,
                                const int w,
                                @restrict const int *idx,
                                @restrict const dfloat *src,
                                @restrict dfloat *dst) {
  for(int b=0; b<(nBlk*w + 255)/256; ++b; @outer(0)){
    for(int t=0; t<256; ++t; @inner(0)){
      const int m = b*256 + t;
      if (m < nBlk*w) {
        const int i = m / w;
        dst[(dlong)idx[i]*w + (m - i*w)] = src[m];
      }
    }
  }
}

// all diagnostics in one pass, one partial result per element (printDiagnostics sums them).
// out[e*10 + q]: q = 0 int u dV, 1..8 the 'wall' integrals (printDiagnostics order), 9 max |V|.
@kernel void diagReduce(const dlong Nelements,
                        const dlong fieldOffset,
                        @restrict const dfloat *Jw,
                        @restrict const dfloat *U,
                        @restrict const dfloat *P,
                        @restrict const dfloat *Wp,
                        @restrict const dfloat *WpDz,
                        @restrict const dfloat *Ww,
                        @restrict const dfloat *WwDz,
                        @restrict dfloat *out) {

  for(dlong e=0; e<Nelements; ++e; @outer(0)){
    @shared dfloat s[10][p_Nq * p_Nq];

    for(int ij=0; ij<p_Nq*p_Nq; ++ij; @inner(0)){
      dfloat a[10];
      for(int q=0; q<10; ++q) a[q] = 0.0;
      for(int k=0; k<p_Nq; ++k){
        const dlong id = e*p_Np + k*p_Nq*p_Nq + ij;
        const dfloat u = U[id], v = U[id + fieldOffset], w = U[id + 2*fieldOffset], p = P[id];
        a[0] += Jw[id] * u;
        a[1] += Wp[id] * u;
        a[2] += Wp[id] * v;
        a[3] += Wp[id] * p;
        a[4] += WpDz[id] * u;
        a[5] += WpDz[id] * v;
        a[6] += Ww[id] * p;
        a[7] += WwDz[id] * u;
        a[8] += WwDz[id] * v;
        a[9] = fmax(a[9], sqrt(u*u + v*v + w*w));
      }
      for(int q=0; q<10; ++q) s[q][ij] = a[q];
    }

    @barrier();  // nekRS builds with okl/add_barriers = false (platform.cpp)

    for(int ij=0; ij<p_Nq*p_Nq; ++ij; @inner(0)){
      if (ij < 10) {
        dfloat r = s[ij][0];
        for(int m=1; m<p_Nq*p_Nq; ++m) r = (ij == 9) ? fmax(r, s[ij][m]) : r + s[ij][m];
        out[e*10 + ij] = r;
      }
    }
  }
}

void udfDirichlet(bcData *bc) {
  if (isField("fluid velocity")) {
    bc->uxFluid = 0.0;
    bc->uyFluid = 0.0;
    bc->uzFluid = 0.0;
  }
}
#endif

void readCaseData() {
  // nekRS lowercases keys and values when it reads the .par
  platform->par->extract("casedata", "coordinatesfile", coordinatesFile);
  platform->par->extract("casedata", "numpanels", N_p);
  platform->par->extract("casedata", "slenderness", slenderness);
  platform->par->extract("casedata", "gaussianwidth", epsilon);
  platform->par->extract("casedata", "gaussiancutoff", rcutFactor);
  platform->par->extract("casedata", "gaussiankernel", gaussianKernel);
  kernel2 = (gaussianKernel == "gauss2");
  nekrsCheck(!kernel2 && gaussianKernel != "gauss", platform->comm.mpiComm(), EXIT_FAILURE,
             "gaussianKernel = %s; use gauss or gauss2\n", gaussianKernel.c_str());
  platform->par->extract("casedata", "ramptime", T_ramp);
  platform->par->extract("casedata", "relaxcutofffrequency", f_c);
  platform->par->extract("casedata", "relaxscheme", relaxScheme);
  relaxCN = (relaxScheme == "cn");
  relaxNone = (relaxScheme == "none");
  nekrsCheck(!relaxCN && !relaxNone && relaxScheme != "euler", platform->comm.mpiComm(), EXIT_FAILURE,
             "relaxScheme = %s; use euler, cn or none\n", relaxScheme.c_str());
  platform->par->extract("casedata", "beatfrequency", f_beat);
  platform->par->extract("casedata", "ciliumlength", L_c);
  platform->par->extract("casedata", "diagnosticinterval", diagInterval);
  platform->par->extract("casedata", "wallplanez", wallPlaneZ);
  platform->par->extract("casedata", "profilecilia", profileCilia);
  platform->par->extract("casedata", "kinematics", kinematics);
  platform->par->extract("casedata", "rodaxis", rodAxis);
  platform->par->extract("casedata", "rodvelocity", rodVelocity);
  platform->par->extract("casedata", "rodcentrez", rodCentreZ);
  platform->par->extract("casedata", "subtractselfflow", subtractSelfFlow);
  platform->par->extract("casedata", "dumppanelsteps", dumpPanelSteps);
  platform->par->extract("casedata", "panellength", panelLength);
  nekrsCheck(panelLength != "uniform" && panelLength != "arclength", platform->comm.mpiComm(), EXIT_FAILURE,
             "panelLength = %s; use uniform or arclength\n", panelLength.c_str());
  platform->par->extract("casedata", "couplingscheme", couplingScheme);
  platform->par->extract("casedata", "couplingtol", couplingTol);
  platform->par->extract("casedata", "couplingmaxiter", couplingMaxIter);
  platform->par->extract("casedata", "couplingomega", couplingOmega);
  platform->par->extract("casedata", "couplingreuse", couplingReuse);
  platform->par->extract("casedata", "couplingrestart", couplingRestart);
  platform->par->extract("casedata", "couplingfilter", couplingFilter);
  platform->par->extract("casedata", "iqnverbose", iqnVerbose);
  platform->par->extract("casedata", "tileperiod", tilePeriod);
  platform->par->extract("casedata", "ciliabinning", ciliaBinning);
  platform->par->extract("casedata", "binwidth", binWidth);
  platform->par->extract("casedata", "binningcheck", binningCheck);
  platform->par->extract("casedata", "iqncheck", iqnCheck);
  platform->par->extract("casedata", "kinematicscheck", kinematicsCheck);
  nekrsCheck(binWidth <= 0, platform->comm.mpiComm(), EXIT_FAILURE, "binWidth = %g; must be > 0\n", binWidth);
  couplingIQN = (couplingScheme == "iqn");
  nekrsCheck(!couplingIQN && couplingScheme != "explicit", platform->comm.mpiComm(), EXIT_FAILURE,
             "couplingScheme = %s; use explicit or iqn\n", couplingScheme.c_str());
  nekrsCheck(couplingIQN && (!relaxNone || subtractSelfFlow == 2), platform->comm.mpiComm(), EXIT_FAILURE,
             "%s\n", "couplingScheme = iqn needs relaxScheme = none and subtractSelfFlow 0 or 1");
  auto axisIndex = [](const std::string &a) { return a == "x" ? 0 : a == "y" ? 1 : a == "z" ? 2 : -1; };
  nekrsCheck(kinematics != "fb" && kinematics != "rod", platform->comm.mpiComm(), EXIT_FAILURE,
             "kinematics = %s; use fb or rod\n", kinematics.c_str());
  nekrsCheck(kinematics == "rod" && (axisIndex(rodAxis) < 0 || axisIndex(rodVelocity) < 0),
             platform->comm.mpiComm(), EXIT_FAILURE, "rodAxis = %s, rodVelocity = %s; use x, y or z\n",
             rodAxis.c_str(), rodVelocity.c_str());

  // Already converted by nekRS: viscosity = -Re in the .par gives 1/Re here
  platform->options.getArgs("FLUID VISCOSITY", mu_hat);
}

void writeForceHistory(double time) {
  if (platform->comm.mpiRank() != 0) return;
  std::ofstream out(forceHistoryFile, std::ios::binary | std::ios::trunc);
  out.write(reinterpret_cast<const char*>(&time), sizeof(time));
  out.write(reinterpret_cast<const char*>(&N_part), sizeof(N_part));
  out.write(reinterpret_cast<const char*>(f_old.data()), f_old.size() * sizeof(dfloat));
  out.write(reinterpret_cast<const char*>(fstar_old.data()), fstar_old.size() * sizeof(dfloat));
}

// After a restart, reload the relaxed forces so the relaxation transient does not restart.
void readForceHistory(double time) {
  int ok = 0;
  double t_saved = 0.0;
  if (platform->comm.mpiRank() == 0) {
    std::ifstream in(forceHistoryFile, std::ios::binary);
    int n_saved = -1;
    if (in.good()) {
      in.read(reinterpret_cast<char*>(&t_saved), sizeof(t_saved));
      in.read(reinterpret_cast<char*>(&n_saved), sizeof(n_saved));
    }
    if (n_saved == N_part && std::abs(time - t_saved) <= 2.0 * nrs->dt[0] + 1e-12) {
      in.read(reinterpret_cast<char*>(f_old.data()), f_old.size() * sizeof(dfloat));
      ok = in.good() ? 1 : 0;
      // f* was added to the file for cn; an older file has none, so start f* from the relaxed force
      if (ok) {
        in.read(reinterpret_cast<char*>(fstar_old.data()), fstar_old.size() * sizeof(dfloat));
        if (!in.good()) fstar_old = f_old;
      }
    }
    if (ok) {
      std::cout << "cilia: restored force history from " << forceHistoryFile
                << " (t = " << t_saved << ")\n";
    } else {
      std::cout << "cilia: WARNING no matching " << forceHistoryFile << " for restart at t = " << time
                << "; relaxed forces restart from zero\n";
    }
  }
  MPI_Bcast(&ok, 1, MPI_INT, 0, platform->comm.mpiComm());
  if (ok) {
    MPI_Bcast(f_old.data(), f_old.size(), MPI_DFLOAT, 0, platform->comm.mpiComm());
    MPI_Bcast(fstar_old.data(), fstar_old.size(), MPI_DFLOAT, 0, platform->comm.mpiComm());
  } else {
    std::fill(f_old.begin(), f_old.end(), 0.0);
    std::fill(fstar_old.begin(), fstar_old.end(), 0.0);
  }
}

// Gaussian-regularised Stokeslet for the blob exp(-r^2/eps^2)/(pi^1.5 eps^3): u = (a F + b (F.rhat) rhat)/mu,
// G = erf(r/eps)/(4 pi r), B'(r) = [(r^2/2 - eps^2/4) erf(r/eps) + eps r e^{-r^2/eps^2}/(2 sqrt pi)]/(4 pi r^2),
// a = G - B'/r, b = 3 B'/r - G (studies/stokeslet_closed_form.py checks it against the Fourier integral).
// gauss2 = (1 - eps^2/4 lap) gauss: G2 = G + (eps^2/4) phi, B2' = B' - (eps^2/4) G'
void regStokeslet(dfloat r, dfloat &a, dfloat &b) {
  const dfloat pi = 4.0 * atan(1.0);
  if (r < 1e-3 * epsilon) { a = (kernel2 ? 1.5 : 1.0) / (3.0 * pow(pi, 1.5) * epsilon); b = 0.0; return; }
  const dfloat E = erf(r / epsilon), ex = exp(-r * r / (epsilon * epsilon));
  dfloat G = E / (4.0 * pi * r);
  dfloat Bp = ((0.5 * r * r - 0.25 * epsilon * epsilon) * E + epsilon * r * ex / (2.0 * sqrt(pi))) / (4.0 * pi * r * r);
  if (kernel2) {
    const dfloat Gp = (2.0 * r * ex / (sqrt(pi) * epsilon) - E) / (4.0 * pi * r * r);
    G += 0.25 * ex / (pow(pi, 1.5) * epsilon);
    Bp -= 0.25 * epsilon * epsilon * Gp;
  }
  a = G - Bp / r;
  b = 3.0 * Bp / r - G;
}

// subtractSelfFlow = 2: per cilium, solve (I - C S) f = C (V - u) with C the 3x3 RFT resistance of each panel
// (R mu l (C_par t t + C_perp (I - t t))) and S the free-space regularised Stokeslet among the cilium's own panels
// at the current positions; lost panels (u = -999) get f = 0
std::vector<dfloat> implicitSelfFlowForce(const std::vector<dfloat> &x_pc, const std::vector<dfloat> &V_cilia,
                                          const std::vector<dfloat> &tl_pc, const std::vector<dfloat> &u_pc, dfloat R) {
  const int n = 3 * N_p;
  std::vector<dfloat> fs(N_part * 3, 0.0), A(n * n), b(n), Cm(N_p * 9);
  for (int k = 0; k < N_cilia; k++) {
    std::vector<char> lost(N_p);
    for (int i = 0; i < N_p; i++) {
      const int idx = k * N_p + i;
      const dfloat* t = &tl_pc[idx*4];
      const dfloat scale = R * mu_hat * tl_pc[idx*4 + 3];
      for (int a = 0; a < 3; a++)
        for (int c = 0; c < 3; c++)
          Cm[i*9 + a*3 + c] = scale * (C_perp * (a == c ? 1.0 : 0.0) + (C_par - C_perp) * t[a] * t[c]);
      lost[i] = (u_pc[idx] == -999.0 && u_pc[idx + N_part] == -999.0 && u_pc[idx + 2 * N_part] == -999.0);
      dfloat Vr[3];
      for (int c = 0; c < 3; c++) Vr[c] = lost[i] ? 0.0 : V_cilia[idx*3 + c] - u_pc[idx + c * N_part];
      for (int a = 0; a < 3; a++) {
        b[i*3 + a] = 0.0;
        for (int c = 0; c < 3; c++) b[i*3 + a] += Cm[i*9 + a*3 + c] * Vr[c];
      }
    }
    // A = I - C S, row block i: -C_i S_ij; S_ij = (a I + b dhat dhat) / mu, d = x_i - x_j
    for (int i = 0; i < N_p; i++) {
      const int ii = k * N_p + i;
      for (int j = 0; j < N_p; j++) {
        const int jj = k * N_p + j;
        dfloat d[3], r = 0.0;
        for (int c = 0; c < 3; c++) { d[c] = x_pc[ii*3 + c] - x_pc[jj*3 + c]; r += d[c] * d[c]; }
        r = sqrt(r);
        dfloat sa, sb;
        regStokeslet(r, sa, sb);
        dfloat S[9];
        for (int a = 0; a < 3; a++)
          for (int c = 0; c < 3; c++)
            S[a*3 + c] = (sa * (a == c ? 1.0 : 0.0) + (r > 0 ? sb * d[a] * d[c] / (r * r) : 0.0)) / mu_hat;
        for (int a = 0; a < 3; a++)
          for (int c = 0; c < 3; c++) {
            dfloat cs = 0.0;
            for (int m = 0; m < 3; m++) cs += Cm[i*9 + a*3 + m] * S[m*3 + c];
            A[(i*3 + a) * n + j*3 + c] = (lost[i] ? 0.0 : -cs) + (i == j && a == c ? 1.0 : 0.0);
          }
      }
    }
    // Gaussian elimination with partial pivoting
    for (int col = 0; col < n; col++) {
      int piv = col;
      for (int r = col + 1; r < n; r++) if (std::abs(A[r*n + col]) > std::abs(A[piv*n + col])) piv = r;
      if (piv != col) { for (int c = 0; c < n; c++) std::swap(A[col*n + c], A[piv*n + c]); std::swap(b[col], b[piv]); }
      for (int r = col + 1; r < n; r++) {
        const dfloat m = A[r*n + col] / A[col*n + col];
        if (m == 0.0) continue;
        for (int c = col; c < n; c++) A[r*n + c] -= m * A[col*n + c];
        b[r] -= m * b[col];
      }
    }
    for (int r = n - 1; r >= 0; r--) {
      dfloat v = b[r];
      for (int c = r + 1; c < n; c++) v -= A[r*n + c] * b[c];
      b[r] = v / A[r*n + r];
    }
    for (int m = 0; m < n; m++) fs[k * N_p * 3 + m] = b[m];
  }
  return fs;
}

// Panel positions x_pc and prescribed velocities V_cilia at this time (Fulford-Blake beat or the rod test),
// the unit tangent and length per panel tl_pc (tx, ty, tz, l; panelLength),
// and px, py, pz: the positions wrapped into the periodic box for the point search
void panelKinematics(double time, std::vector<dfloat> &x_pc, std::vector<dfloat> &V_cilia, std::vector<dfloat> &tl_pc,
                     std::vector<dfloat> &px, std::vector<dfloat> &py, std::vector<dfloat> &pz) {
  const dfloat pi = 4.0 * atan(1.0);
  const dfloat omega = 2.0 * pi * f_beat;

  px.assign(N_part, 0.0); py.assign(N_part, 0.0); pz.assign(N_part, 0.0);
  x_pc.assign(N_part * 3, 0.0);
  V_cilia.assign(N_part * 3, 0.0);
  tl_pc.assign(N_part * 4, 0.0);
  const bool arclength = (panelLength == "arclength");

  int n = 0;
  for(int k=0; k<N_cilia; k++) {
    for(int i=0; i<N_p; i++) {
      dfloat s = (dfloat)(i + 0.5) / (dfloat)N_p;

      if (kinematics == "rod") {
        const dfloat c[3] = {xc[k], yc[k], rodCentreZ};
        for (int d = 0; d < 3; d++) {
          x_pc[n*3 + d] = c[d] + (rodAxis[0] - 'x' == d ? (s - 0.5) * L_c : 0.0);
          V_cilia[n*3 + d] = (rodVelocity[0] - 'x' == d) ? 1.0 : 0.0;
          tl_pc[n*4 + d] = (rodAxis[0] - 'x' == d) ? 1.0 : 0.0;
        }
        tl_pc[n*4 + 3] = l_panel;
        px[n] = x_pc[n*3 + 0]; py[n] = x_pc[n*3 + 1]; pz[n] = x_pc[n*3 + 2];
        n++;
        continue;
      }

      dfloat xi1 = 0.5 * coeff(A1, 1, s);
      dfloat xi2 = 0.5 * coeff(A2, 1, s);
      dfloat dxi1 = 0.0, dxi2 = 0.0;
      dfloat sxi1 = 0.5 * dcoeff(A1, 1, s), sxi2 = 0.5 * dcoeff(A2, 1, s);   // d/ds

      for(int j=1; j<=N_o; j++){
        dfloat wt = j * omega * time;
        xi1 += coeff(A1, j+1, s)*cos(wt) + coeff(B1, j, s)*sin(wt);
        dxi1 -= (j*omega)*coeff(A1, j+1, s)*sin(wt) - (j*omega)*coeff(B1, j, s)*cos(wt);

        xi2 += coeff(A2, j+1, s)*cos(wt) + coeff(B2, j, s)*sin(wt);
        dxi2 -= (j*omega)*coeff(A2, j+1, s)*sin(wt) - (j*omega)*coeff(B2, j, s)*cos(wt);

        sxi1 += dcoeff(A1, j+1, s)*cos(wt) + dcoeff(B1, j, s)*sin(wt);
        sxi2 += dcoeff(A2, j+1, s)*cos(wt) + dcoeff(B2, j, s)*sin(wt);
      }

      // Scale by cilium length, rotate the beat plane by beta about z
      px[n] = L_c * xi1 * cos(beta_c[k]) + xc[k];
      py[n] = L_c * xi1 * sin(beta_c[k]) + yc[k];
      pz[n] = L_c * xi2;

      x_pc[n*3 + 0] = px[n];
      x_pc[n*3 + 1] = py[n];
      x_pc[n*3 + 2] = pz[n];

      V_cilia[n*3 + 0] = L_c * dxi1 * cos(beta_c[k]);
      V_cilia[n*3 + 1] = L_c * dxi1 * sin(beta_c[k]);
      V_cilia[n*3 + 2] = L_c * dxi2;

      if (arclength) {
        const dfloat sn = sqrt(sxi1 * sxi1 + sxi2 * sxi2);
        tl_pc[n*4 + 0] = sxi1 * cos(beta_c[k]) / sn;
        tl_pc[n*4 + 1] = sxi1 * sin(beta_c[k]) / sn;
        tl_pc[n*4 + 2] = sxi2 / sn;
        tl_pc[n*4 + 3] = L_c * sn / N_p;
      }

      n++;
    }
  }

  // uniform: tangent by centred differences inside, one-sided at the ends; l = L_c/N_p
  if (!arclength && kinematics != "rod") {
    for (int k = 0; k < N_cilia; k++)
      for (int i = 0; i < N_p; i++) {
        const int idx = k * N_p + i;
        const int idxm = (i == 0) ? idx : idx - 1, idxp = (i == N_p - 1) ? idx : idx + 1;
        dfloat t[3], tn = 0.0;
        for (int c = 0; c < 3; c++) { t[c] = x_pc[idxp*3 + c] - x_pc[idxm*3 + c]; tn += t[c] * t[c]; }
        tn = sqrt(tn);
        for (int c = 0; c < 3; c++) tl_pc[idx*4 + c] = tn > 1.0e-14 ? t[c] / tn : 0.0;
        tl_pc[idx*4 + 3] = l_panel;
      }
  }

  // Wrap into the periodic box so panels that leave through a side are found on the other side
  // (x_pc stays unwrapped for the tangents; the force kernel uses minimum-image distances)
  for (int m = 0; m < N_part; ++m) {
    px[m] -= Lx * std::floor((px[m] - xmin) / Lx);
    py[m] -= Ly * std::floor((py[m] - ymin) / Ly);
  }
}

// ---------------------------------------------------------------------------
// Binning. Uniform bins over the box: nbx x nby periodic, nbz from the mesh z range (panels outside it go
// into the end bins, which every element whose range reaches past that end also visits). Per element (static
// mesh) the bins within r_cut of its bounding box; per panel position a stable counting sort, so each bin's panels
// stay in index order: on the device for iqn (deviceKinematics), on the host for explicit coupling.
// ---------------------------------------------------------------------------
int nbx = 1, nby = 1, nbz = 1;
dfloat hbx, hby, hbz, zlo;
std::vector<int> binStart, binPanel;
std::vector<int> elemBinsHost;   // the per-element bin ranges, also on the host (setupOwnership)
occa::memory o_elemBins, o_binStart, o_binPanel;
occa::memory o_chkA, o_chkB, o_chkC;   // binningCheck spare fields
int binChecks = 0;

void setupBins() {
  auto mesh = nrs->meshV;
  const dfloat rcut = sqrt(rcut2);
  const dfloat h = binWidth * rcut;
  zlo = platform->linAlg->min(mesh->Nlocal, mesh->o_z, platform->comm.mpiComm());
  const dfloat Lz = platform->linAlg->max(mesh->Nlocal, mesh->o_z, platform->comm.mpiComm()) - zlo;
  nbx = std::max(1, (int)std::floor(Lx / h));
  nby = std::max(1, (int)std::floor(Ly / h));
  nbz = std::max(1, (int)std::floor(Lz / h));
  hbx = Lx / nbx; hby = Ly / nby; hbz = Lz / nbz;

  std::vector<dfloat> X(mesh->Nlocal), Y(mesh->Nlocal), Z(mesh->Nlocal);
  mesh->o_x.copyTo(X.data(), mesh->Nlocal);
  mesh->o_y.copyTo(Y.data(), mesh->Nlocal);
  mesh->o_z.copyTo(Z.data(), mesh->Nlocal);
  // Bin range of [lo - r_cut, hi + r_cut] (a small margin against round-off at bin edges)
  const dfloat pad = rcut * (1.0 + 1e-6);
  auto periodicRange = [](dfloat lo, dfloat hi, dfloat o, dfloat hb, int nb, int &first, int &count) {
    const int a = (int)std::floor((lo - o) / hb), b = (int)std::floor((hi - o) / hb);
    count = b - a + 1;
    if (count >= nb) { first = 0; count = nb; }
    else first = ((a % nb) + nb) % nb;
  };
  std::vector<int> eb(mesh->Nelements * 6);
  long visited = 0;
  for (dlong e = 0; e < mesh->Nelements; e++) {
    dfloat lo[3] = {1e300, 1e300, 1e300}, hi[3] = {-1e300, -1e300, -1e300};
    for (int n = 0; n < mesh->Np; n++) {
      const dlong id = e * mesh->Np + n;
      const dfloat p[3] = {X[id], Y[id], Z[id]};
      for (int d = 0; d < 3; d++) { lo[d] = std::min(lo[d], p[d]); hi[d] = std::max(hi[d], p[d]); }
    }
    int *b = &eb[e * 6];
    periodicRange(lo[0] - pad, hi[0] + pad, xmin, hbx, nbx, b[0], b[1]);
    periodicRange(lo[1] - pad, hi[1] + pad, ymin, hby, nby, b[2], b[3]);
    b[4] = std::clamp((int)std::floor((lo[2] - pad - zlo) / hbz), 0, nbz - 1);
    b[5] = std::clamp((int)std::floor((hi[2] + pad - zlo) / hbz), 0, nbz - 1);
    visited += (long)b[1] * b[3] * (b[5] - b[4] + 1);
  }
  if (mesh->Nelements > 0) {
    o_elemBins = platform->device.malloc<int>(eb.size());
    o_elemBins.copyFrom(eb.data());
  }
  elemBinsHost = eb;
  binStart.assign(nbx * nby * nbz + 1, 0);
  binPanel.assign(N_part, 0);
  o_binStart = platform->device.malloc<int>(binStart.size());
  o_binPanel = platform->device.malloc<int>(N_part);

  MPI_Allreduce(MPI_IN_PLACE, &visited, 1, MPI_LONG, MPI_SUM, platform->comm.mpiComm());
  long nel = mesh->Nelements;
  MPI_Allreduce(MPI_IN_PLACE, &nel, 1, MPI_LONG, MPI_SUM, platform->comm.mpiComm());
  if (platform->comm.mpiRank() == 0)
    printf("cilia: binning = %d  bins %d x %d x %d (%.4g x %.4g x %.4g; r_cut = %.4g)  mean bins per element %.1f"
           "  binningCheck = %d\n", ciliaBinning, nbx, nby, nbz, hbx, hby, hbz, rcut,
           nel > 0 ? (double)visited / nel : 0.0, binningCheck);
}

// ---------------------------------------------------------------------------
// Ownership. The owner of a cilium is the rank whose elements hold its root (find() on the roots at setup).
// A rank's local cilia are every cilium whose panel centres can come within r_cut of one of its elements: the
// footprint of the panel centres over a beat (the beat-frame range sampled at setup, plus a margin from the
// sampled speed) touches an x-y bin column that one of its elements visits (the elemBins ranges already hold
// r_cut). Roots don't move, so the sets are static. localCilia is sorted by global id, so a stable bin sort of the
// local panels keeps the 1-rank summation order. Halo F exchange: the owner sends cilium k to every rank that
// holds k as halo (sendLocal / recvLocal: positions in localCilia, per neighbour rank).
// ---------------------------------------------------------------------------
int nRanks = 1, myRank = 0;
std::vector<int> ciliumOwner;                        // N_cilia
std::vector<int> localCilia;                         // global ids, ascending: own + halo
std::vector<int> ownLocal;                           // positions in localCilia of the own cilia
std::vector<int> nbrRank;                            // ranks this one exchanges halo F with
std::vector<std::vector<int>> sendLocal, recvLocal;  // per nbrRank entry: own cilia to send, halo cilia to fill
dfloat beatLo = 0, beatHi = 0, beatMargin = 0;       // panel-centre range along the beat direction (/ L_c), margin

// Range of the panel centres' xi1 (along the beat) over one cycle, from nSample phases; the margin is the largest
// sampled panel speed times the sample spacing (a point moves at most that far between two samples)
void beatReach() {
  if (kinematics == "rod") { beatLo = beatHi = 0; beatMargin = 0.5 * L_c * (1.0 + 1e-6); return; }
  const dfloat pi = 4.0 * atan(1.0);
  const dfloat omega = 2.0 * pi * f_beat;
  const int nSample = 4000;
  beatLo = 0; beatHi = 0;   // the root itself, so the owner (root element) always holds its cilium
  dfloat vmax = 0;
  for (int q = 0; q < nSample; q++) {
    const dfloat t = q / (nSample * f_beat);
    for (int i = 0; i < N_p; i++) {
      const dfloat s = (i + 0.5) / N_p;
      dfloat xi1 = 0.5 * coeff(A1, 1, s), dxi1 = 0, dxi2 = 0;
      for (int j = 1; j <= N_o; j++) {
        const dfloat wt = j * omega * t;
        xi1 += coeff(A1, j+1, s)*cos(wt) + coeff(B1, j, s)*sin(wt);
        dxi1 -= (j*omega)*coeff(A1, j+1, s)*sin(wt) - (j*omega)*coeff(B1, j, s)*cos(wt);
        dxi2 -= (j*omega)*coeff(A2, j+1, s)*sin(wt) - (j*omega)*coeff(B2, j, s)*cos(wt);
      }
      beatLo = std::min(beatLo, xi1);
      beatHi = std::max(beatHi, xi1);
      vmax = std::max(vmax, (dfloat)sqrt(dxi1 * dxi1 + dxi2 * dxi2));
    }
  }
  beatMargin = 2.0 * L_c * vmax / (nSample * f_beat) + 1e-9;
}

// Bin columns [first, first + count) (mod nb) covering [lo, hi]; count = nb when it wraps all the way
void columnRange(dfloat lo, dfloat hi, dfloat o, dfloat hb, int nb, int &first, int &count) {
  const int a = (int)std::floor((lo - o) / hb), b = (int)std::floor((hi - o) / hb);
  count = b - a + 1;
  if (count >= nb) { first = 0; count = nb; }
  else first = ((a % nb) + nb) % nb;
}

// Bin columns [fx, fx + cx) x [fy, fy + cy) (mod nbx, nby) that cilium k's panel centres can reach over a beat:
// the segment root + L_c [beatLo, beatHi] (cos beta, sin beta) grown by the margin (rod: a square of half-width
// L_c/2 about the root)
void ciliumColumns(int k, int &fx, int &cx, int &fy, int &cy) {
  const dfloat cb = cos(beta_c[k]), sb = sin(beta_c[k]);
  const dfloat xa = xc[k] + L_c * beatLo * cb, xb = xc[k] + L_c * beatHi * cb;
  const dfloat ya = yc[k] + L_c * beatLo * sb, yb = yc[k] + L_c * beatHi * sb;
  columnRange(std::min(xa, xb) - beatMargin, std::max(xa, xb) + beatMargin, xmin, hbx, nbx, fx, cx);
  columnRange(std::min(ya, yb) - beatMargin, std::max(ya, yb) + beatMargin, ymin, hby, nby, fy, cy);
}

void setupOwnership() {
  auto comm = platform->comm.mpiComm();
  MPI_Comm_size(comm, &nRanks);
  MPI_Comm_rank(comm, &myRank);
  beatReach();

  // Owner: find() on the roots, round-robin over the ranks (one dummy point on a rank with none)
  std::vector<dfloat> rx, ry, rz;
  std::vector<int> ids;
  for (int k = myRank; k < N_cilia; k += nRanks) {
    ids.push_back(k);
    rx.push_back(xc[k] - Lx * std::floor((xc[k] - xmin) / Lx));
    ry.push_back(yc[k] - Ly * std::floor((yc[k] - ymin) / Ly));
    rz.push_back(0.0);
  }
  if (ids.empty()) { rx.push_back(xmin); ry.push_back(ymin); rz.push_back(0.0); }
  interp->setPoints(rx, ry, rz);
  interp->find();
  ciliumOwner.assign(N_cilia, -1);
  for (size_t j = 0; j < ids.size(); j++)
    if (interp->data().code[j] != 2) ciliumOwner[ids[j]] = interp->data().proc[j];   // 2: not found
  MPI_Allreduce(MPI_IN_PLACE, ciliumOwner.data(), N_cilia, MPI_INT, MPI_MAX, comm);
  int lost = 0;
  for (int k = 0; k < N_cilia; k++) lost += ciliumOwner[k] < 0;
  nekrsCheck(lost > 0, comm, EXIT_FAILURE, "%d cilium roots not found in the mesh\n", lost);

  // Columns visited by this rank's elements
  std::vector<char> col((size_t)nbx * nby, 0);
  for (size_t e = 0; e * 6 < elemBinsHost.size(); e++) {
    const int *b = &elemBinsHost[e * 6];
    for (int jy = 0; jy < b[3]; jy++)
      for (int jx = 0; jx < b[1]; jx++)
        col[(size_t)((b[2] + jy) % nby) * nbx + (b[0] + jx) % nbx] = 1;
  }

  // Local cilia: the footprint columns (ciliumColumns) meet a column this rank visits
  localCilia.clear();
  ownLocal.clear();
  for (int k = 0; k < N_cilia; k++) {
    bool local = (ciliumOwner[k] == myRank);
    if (!local) {
      int fx, cx, fy, cy;
      ciliumColumns(k, fx, cx, fy, cy);
      for (int jy = 0; jy < cy && !local; jy++)
        for (int jx = 0; jx < cx && !local; jx++)
          local = col[(size_t)((fy + jy) % nby) * nbx + (fx + jx) % nbx];
    }
    if (local) {
      if (ciliumOwner[k] == myRank) ownLocal.push_back(localCilia.size());
      localCilia.push_back(k);
    }
  }

  // Exchange lists: tell each owner which of its cilia this rank holds as halo
  std::vector<std::vector<int>> want(nRanks);
  std::vector<std::vector<int>> wantPos(nRanks);
  for (size_t m = 0; m < localCilia.size(); m++) {
    const int o = ciliumOwner[localCilia[m]];
    if (o != myRank) { want[o].push_back(localCilia[m]); wantPos[o].push_back(m); }
  }
  std::vector<int> nWant(nRanks), nGive(nRanks), dW(nRanks + 1, 0), dG(nRanks + 1, 0);
  for (int r = 0; r < nRanks; r++) nWant[r] = want[r].size();
  MPI_Alltoall(nWant.data(), 1, MPI_INT, nGive.data(), 1, MPI_INT, comm);
  for (int r = 0; r < nRanks; r++) { dW[r + 1] = dW[r] + nWant[r]; dG[r + 1] = dG[r] + nGive[r]; }
  std::vector<int> wantFlat(dW[nRanks]), giveFlat(dG[nRanks]);
  for (int r = 0; r < nRanks; r++) std::copy(want[r].begin(), want[r].end(), wantFlat.begin() + dW[r]);
  MPI_Alltoallv(wantFlat.data(), nWant.data(), dW.data(), MPI_INT, giveFlat.data(), nGive.data(), dG.data(), MPI_INT, comm);
  nbrRank.clear(); sendLocal.clear(); recvLocal.clear();
  for (int r = 0; r < nRanks; r++) {
    if (nWant[r] == 0 && nGive[r] == 0) continue;
    nbrRank.push_back(r);
    recvLocal.push_back(wantPos[r]);
    std::vector<int> snd;
    for (int j = dG[r]; j < dG[r + 1]; j++) {
      const int pos = std::lower_bound(localCilia.begin(), localCilia.end(), giveFlat[j]) - localCilia.begin();
      nekrsCheck(pos == (int)localCilia.size() || localCilia[pos] != giveFlat[j] || ciliumOwner[giveFlat[j]] != myRank,
                 MPI_COMM_SELF, EXIT_FAILURE, "rank %d asked for cilium %d it does not own\n", r, giveFlat[j]);
      snd.push_back(pos);
    }
    sendLocal.push_back(snd);
  }

  // Report: own, halo and local panels per rank (min / max over ranks), and the exchange volume
  long st[4] = {(long)ownLocal.size(), (long)(localCilia.size() - ownLocal.size()), (long)localCilia.size() * N_p,
                (long)nbrRank.size()};
  long mn[4], mx[4], sum[4];
  MPI_Allreduce(st, mn, 4, MPI_LONG, MPI_MIN, comm);
  MPI_Allreduce(st, mx, 4, MPI_LONG, MPI_MAX, comm);
  MPI_Allreduce(st, sum, 4, MPI_LONG, MPI_SUM, comm);
  nekrsCheck(sum[0] != N_cilia, comm, EXIT_FAILURE, "owned cilia sum to %ld, not %d\n", sum[0], N_cilia);
  if (myRank == 0)
    printf("cilia: ownership: %d ranks, beat reach [%.4f, %.4f] L_c + %.2e; own %ld-%ld, halo %ld-%ld, local panels"
           " %ld-%ld (of %d), neighbours %ld-%ld per rank\n", nRanks, beatLo, beatHi, beatMargin, mn[0], mx[0], mn[1],
           mx[1], mn[2], mx[2], N_part, mn[3], mx[3]);
}

// Halo exchange of a per-panel host vector in the local layout (nc entries per panel): the own cilia's entries go
// to the ranks that hold them as halo. Host-staged.
void haloExchange(std::vector<dfloat> &v, int nc) {
  auto comm = platform->comm.mpiComm();
  const int w = N_p * nc;   // entries per cilium
  std::vector<std::vector<dfloat>> sbuf(nbrRank.size()), rbuf(nbrRank.size());
  std::vector<MPI_Request> req;
  for (size_t j = 0; j < nbrRank.size(); j++) {
    rbuf[j].resize(recvLocal[j].size() * w);
    if (!rbuf[j].empty()) {
      req.emplace_back();
      MPI_Irecv(rbuf[j].data(), rbuf[j].size(), MPI_DFLOAT, nbrRank[j], 31, comm, &req.back());
    }
  }
  for (size_t j = 0; j < nbrRank.size(); j++) {
    for (int pos : sendLocal[j]) sbuf[j].insert(sbuf[j].end(), v.begin() + (size_t)pos * w, v.begin() + (size_t)(pos + 1) * w);
    if (!sbuf[j].empty()) {
      req.emplace_back();
      MPI_Isend(sbuf[j].data(), sbuf[j].size(), MPI_DFLOAT, nbrRank[j], 31, comm, &req.back());
    }
  }
  MPI_Waitall(req.size(), req.data(), MPI_STATUSES_IGNORE);
  for (size_t j = 0; j < nbrRank.size(); j++)
    for (size_t m = 0; m < recvLocal[j].size(); m++)
      std::copy(rbuf[j].begin() + m * w, rbuf[j].begin() + (m + 1) * w, v.begin() + (size_t)recvLocal[j][m] * w);
}

// Stable counting sort of the (wrapped) panel positions into the bins (host: explicit coupling, kinematicsCheck)
void hostBinSort(const std::vector<dfloat> &px, const std::vector<dfloat> &py, const std::vector<dfloat> &pz,
                 std::vector<int> &start, std::vector<int> &panel) {
  const int n = px.size();
  std::vector<int> bin(n);
  start.assign((size_t)nbx * nby * nbz + 1, 0);
  panel.assign(n, 0);
  for (int m = 0; m < n; m++) {
    const int ix = std::clamp((int)std::floor((px[m] - xmin) / hbx), 0, nbx - 1);
    const int iy = std::clamp((int)std::floor((py[m] - ymin) / hby), 0, nby - 1);
    const int iz = std::clamp((int)std::floor((pz[m] - zlo) / hbz), 0, nbz - 1);
    bin[m] = (iz * nby + iy) * nbx + ix;
    start[bin[m] + 1]++;
  }
  for (size_t b = 1; b < start.size(); b++) start[b] += start[b - 1];
  std::vector<int> next(start.begin(), start.end() - 1);
  for (int m = 0; m < n; m++) panel[next[bin[m]]++] = m;
}

void binPanels(const std::vector<dfloat> &px, const std::vector<dfloat> &py, const std::vector<dfloat> &pz) {
  if (!ciliaBinning && !binningCheck) return;
  ptic("udfSource::binPanels");
  hostBinSort(px, py, pz, binStart, binPanel);
  o_binStart.copyFrom(binStart.data());
  o_binPanel.copyFrom(binPanel.data());
  ptoc("udfSource::binPanels");
}

// o_FU0 (iqn): write o_FU = o_FU0 + spread instead of o_FU += spread. The panels are the local ones in iqn
// (o_xpc, o_fl: own + halo cilia) and all of them otherwise (o_xpc, o_f)
void launchSpread(bool binned, int useJw, occa::memory &o_FU, occa::memory *o_FU0 = nullptr) {
  auto mesh = nrs->meshV;
  if (mesh->Nelements == 0) return;
  occa::memory &o_F = couplingIQN ? o_fl : o_f;
  const int nSpread = couplingIQN ? kinPanels : N_part;
  if (binned) {
    addCiliaForceBinned(mesh->Nelements, nrs->fluid->fieldOffset, nbx, nby, o_elemBins, o_binStart, o_binPanel,
                        o_xpc, o_F, epsinv2, rcut2, invnorm, kernel2, Lx, Ly, mesh->o_x, mesh->o_y, mesh->o_z,
                        useJw, mesh->o_Jw, o_FU0 ? 1 : 0, o_FU0 ? *o_FU0 : o_FU, o_FU);
  } else {
    addCiliaForce(mesh->Nelements, nrs->fluid->fieldOffset, nSpread, o_xpc, o_F, epsinv2, rcut2, invnorm, kernel2,
                  Lx, Ly, mesh->o_x, mesh->o_y, mesh->o_z, useJw, mesh->o_Jw, o_FU0 ? 1 : 0,
                  o_FU0 ? *o_FU0 : o_FU, o_FU);
  }
}

// Spread the panel forces onto the mesh and add them to o_FU (times Jw if useJw); with o_FU0, o_FU = o_FU0 + spread.
// binningCheck: the first calls also compare binned and brute force on zeroed spare fields (and fused vs add)
void spreadForces(int useJw, occa::memory &o_FU, occa::memory *o_FU0 = nullptr) {
  if (binChecks < binningCheck) {
    binChecks++;
    const dlong n3 = 3 * nrs->fluid->fieldOffset;
    if (!o_chkA.isInitialized()) { o_chkA = platform->device.malloc<dfloat>(n3); o_chkB = platform->device.malloc<dfloat>(n3); }
    platform->linAlg->fill(n3, 0.0, o_chkA);
    platform->linAlg->fill(n3, 0.0, o_chkB);
    launchSpread(true, useJw, o_chkA);
    launchSpread(false, useJw, o_chkB);
    const dlong N = nrs->meshV->Nlocal, off = nrs->fluid->fieldOffset;
    const dfloat err = platform->linAlg->maxAbsoluteError(N, 3, off, -1.0, o_chkA, o_chkB, platform->comm.mpiComm());
    const dfloat ref = platform->linAlg->amaxMany(N, 3, off, o_chkB, platform->comm.mpiComm());
    // fused: o_FU0 + spread (o_FU0 = the brute-force spread, any nonzero field) must equal o_FU0 + spread added in place
    if (!o_chkC.isInitialized()) o_chkC = platform->device.malloc<dfloat>(n3);
    platform->linAlg->fill(n3, 0.0, o_chkC);
    launchSpread(true, useJw, o_chkC, &o_chkB);
    launchSpread(true, useJw, o_chkB);   // o_chkB += spread (binned; o_chkB held the brute-force spread)
    const dfloat errF = platform->linAlg->maxAbsoluteError(N, 3, off, -1.0, o_chkC, o_chkB, platform->comm.mpiComm());
    if (platform->comm.mpiRank() == 0)
      printf("%d %.3e %.3e %.3e %.3e  bincheck\n", binChecks, err, ref, ref > 0 ? err / ref : 0.0, errF);
  }
  ptic("udfSource::addCiliaForce");
  launchSpread(ciliaBinning, useJw, o_FU, o_FU0);
  ptoc("udfSource::addCiliaForce");
}

void locatePanels(const std::vector<dfloat> &px, const std::vector<dfloat> &py, const std::vector<dfloat> &pz) {
  binPanels(px, py, pz);
  ptic("udfSource::copyPoints");
  o_px.copyFrom(px.data());
  o_py.copyFrom(py.data());
  o_pz.copyFrom(pz.data());
  ptoc("udfSource::copyPoints");

  ptic("udfSource::find");
  interp->setPoints(o_px, o_py, o_pz);
  interp->find();
  ptoc("udfSource::find");
}

// ---------------------------------------------------------------------------
// kinematics and binning on the device (iqn path). The device panel layout holds the cilia kinCilia (global
// ids, ascending), panel kk N_p + i = panel i of cilium kinCilia[kk]. the rank's localCilia (own + halo).
// Binning: each x-y bin column lists the cilia whose beat footprint (ciliumColumns) touches it; ciliaBinColumns
// walks those lists, so the bins come out in the host sort's order without atomics. A panel outside its
// footprint would be dropped: ciliaBinScan counts the shortfall in o_binLost (checked at the diagnostics).
// ---------------------------------------------------------------------------
std::vector<int> kinCilia;
occa::memory o_kinRoot, o_beatCoef, o_colStart, o_colCilia, o_binCnt, o_binLost;
int kinChecks = 0;
dfloat kinErr[4] = {0, 0, 0, 0};   // the last kinematicsCompare: x, V, t l, wrapped points
long kinDiff[2] = {0, 0};          // and differing binStart, binPanel entries

void setupDeviceKinematics(const std::vector<int> &cilia) {
  kinCilia = cilia;
  kinPanels = cilia.size() * N_p;
  const int nc = cilia.size();
  std::vector<dfloat> root(std::max(1, nc * 3), 0.0);
  for (int kk = 0; kk < nc; kk++) {
    root[kk * 3 + 0] = xc[cilia[kk]];
    root[kk * 3 + 1] = yc[cilia[kk]];
    root[kk * 3 + 2] = beta_c[cilia[kk]];
  }
  o_kinRoot = platform->device.malloc<dfloat>(root.size());
  o_kinRoot.copyFrom(root.data());
  std::vector<dfloat> coef;
  coef.insert(coef.end(), A1, A1 + 21);
  coef.insert(coef.end(), A2, A2 + 21);
  coef.insert(coef.end(), B1, B1 + 18);
  coef.insert(coef.end(), B2, B2 + 18);
  o_beatCoef = platform->device.malloc<dfloat>(coef.size());
  o_beatCoef.copyFrom(coef.data());

  // Column candidate lists (CSR), cilia ascending in each column
  const int nCol = nbx * nby;
  std::vector<int> colStart(nCol + 1, 0);
  std::vector<int> foot(nc * 4);
  for (int kk = 0; kk < nc; kk++) {
    int *f = &foot[kk * 4];
    ciliumColumns(cilia[kk], f[0], f[1], f[2], f[3]);
    for (int jy = 0; jy < f[3]; jy++)
      for (int jx = 0; jx < f[1]; jx++) colStart[((f[2] + jy) % nby) * nbx + (f[0] + jx) % nbx + 1]++;
  }
  for (int c = 0; c < nCol; c++) colStart[c + 1] += colStart[c];
  std::vector<int> colCilia(std::max(1, colStart[nCol])), next(colStart.begin(), colStart.end() - 1);
  int colMax = 0;
  for (int c = 0; c < nCol; c++) colMax = std::max(colMax, colStart[c + 1] - colStart[c]);
  for (int kk = 0; kk < nc; kk++) {
    const int *f = &foot[kk * 4];
    for (int jy = 0; jy < f[3]; jy++)
      for (int jx = 0; jx < f[1]; jx++) colCilia[next[((f[2] + jy) % nby) * nbx + (f[0] + jx) % nbx]++] = kk;
  }
  o_colStart = platform->device.malloc<int>(colStart.size());
  o_colStart.copyFrom(colStart.data());
  o_colCilia = platform->device.malloc<int>(colCilia.size());
  o_colCilia.copyFrom(colCilia.data());
  o_binCnt = platform->device.malloc<int>((size_t)nCol * nbz);
  o_binLost = platform->device.malloc<int>(1);
  const int zero = 0;
  o_binLost.copyFrom(&zero, 1);
  std::vector<int> start0((size_t)nCol * nbz + 1, 0);   // the bins of a rank with no panels stay empty
  o_binStart.copyFrom(start0.data());

  if (platform->comm.mpiRank() == 0)
    printf("cilia: device kinematics + binning: %d cilia, %d panels; column lists %.1f cilia per cilium, max %d per"
           " column; kinematicsCheck = %d\n", nc, kinPanels, nc > 0 ? (double)colStart[nCol] / nc : 0.0, colMax,
           kinematicsCheck);
}

void deviceKinematics(double time) {
  const dfloat pi = 4.0 * atan(1.0);
  const dfloat omega = 2.0 * pi * f_beat;
  ptic("udfSource::kinematics");   // tic/toc also with no local cilia (see gatherOwnKinematics)
  if (kinPanels > 0) {
    ciliaKinematics(kinPanels, N_p, N_o, (int)(kinematics == "rod"), (int)(panelLength == "arclength"),
                    (dfloat)time, omega, L_c, l_panel, (int)(rodAxis[0] - 'x'), (int)(rodVelocity[0] - 'x'),
                    rodCentreZ, xmin, ymin, Lx, Ly, o_kinRoot, o_beatCoef, o_xpc, o_V, o_TL, o_px, o_py, o_pz);
  }
  ptoc("udfSource::kinematics");
  if (!ciliaBinning && !binningCheck) return;
  ptic("udfSource::binPanels");
  if (kinPanels == 0) { ptoc("udfSource::binPanels"); return; }
  const int nCol = nbx * nby;
  ciliaBinColumns(0, nCol, nbx, nby, nbz, N_p, xmin, ymin, zlo, hbx, hby, hbz, o_colStart, o_colCilia, o_px, o_py,
                  o_pz, o_binStart, o_binCnt, o_binPanel);
  ciliaBinScan(nCol * nbz, kinPanels, o_binCnt, o_binStart, o_binLost);
  ciliaBinColumns(1, nCol, nbx, nby, nbz, N_p, xmin, ymin, zlo, hbx, hby, hbz, o_colStart, o_colCilia, o_px, o_py,
                  o_pz, o_binStart, o_binCnt, o_binPanel);
  ptoc("udfSource::binPanels");
}

// kinematicsCheck: the host kinematics and bin sort for the same cilia; max |device - host| / max |host| of x, V,
// t l and the wrapped points, and the number of differing binStart and binPanel entries
void kinematicsCompare(double time) {
  std::vector<dfloat> X, V, TL, px, py, pz;
  panelKinematics(time, X, V, TL, px, py, pz);
  const int n = kinPanels;
  std::vector<dfloat> hX(3 * n), hV(3 * n), hTL(4 * n), hP(3 * n), hpx(n), hpy(n), hpz(n);
  for (int m = 0; m < n; m++) {
    const int g = kinCilia[m / N_p] * N_p + m % N_p;
    for (int c = 0; c < 3; c++) { hX[m * 3 + c] = X[g * 3 + c]; hV[m * 3 + c] = V[g * 3 + c]; }
    for (int c = 0; c < 4; c++) hTL[m * 4 + c] = TL[g * 4 + c];
    hpx[m] = px[g]; hpy[m] = py[g]; hpz[m] = pz[g];
    hP[m * 3 + 0] = px[g]; hP[m * 3 + 1] = py[g]; hP[m * 3 + 2] = pz[g];
  }
  std::vector<dfloat> dX(3 * n), dV(3 * n), dTL(4 * n), dpx(n), dpy(n), dpz(n), dP(3 * n);
  o_xpc.copyTo(dX.data(), 3 * n);
  o_V.copyTo(dV.data(), 3 * n);
  o_TL.copyTo(dTL.data(), 4 * n);
  o_px.copyTo(dpx.data(), n);
  o_py.copyTo(dpy.data(), n);
  o_pz.copyTo(dpz.data(), n);
  for (int m = 0; m < n; m++) { dP[m * 3 + 0] = dpx[m]; dP[m * 3 + 1] = dpy[m]; dP[m * 3 + 2] = dpz[m]; }
  auto rel = [](const std::vector<dfloat> &a, const std::vector<dfloat> &b) {
    dfloat e = 0, r = 0;
    for (size_t j = 0; j < b.size(); j++) { e = std::max(e, std::abs(a[j] - b[j])); r = std::max(r, std::abs(b[j])); }
    return r > 0 ? e / r : e;
  };
  dfloat err[4] = {rel(dX, hX), rel(dV, hV), rel(dTL, hTL), rel(dP, hP)};
  long diff[2] = {0, 0};
  if (ciliaBinning || binningCheck) {
    std::vector<int> hs, hp, ds((size_t)nbx * nby * nbz + 1), dp(std::max(1, n));
    hostBinSort(hpx, hpy, hpz, hs, hp);
    o_binStart.copyTo(ds.data(), ds.size());
    o_binPanel.copyTo(dp.data(), n);
    for (size_t b = 0; b < hs.size(); b++) diff[0] += hs[b] != ds[b];
    for (int m = 0; m < n; m++) diff[1] += hp[m] != dp[m];
  }
  auto comm = platform->comm.mpiComm();
  MPI_Allreduce(MPI_IN_PLACE, err, 4, MPI_DFLOAT, MPI_MAX, comm);
  MPI_Allreduce(MPI_IN_PLACE, diff, 2, MPI_LONG, MPI_SUM, comm);
  std::copy(err, err + 4, kinErr);
  std::copy(diff, diff + 2, kinDiff);
  if (platform->comm.mpiRank() == 0)
    printf("%d %.10e %.3e %.3e %.3e %.3e %ld %ld  kincheck\n", kinChecks, time, err[0], err[1], err[2], err[3], diff[0],
           diff[1]);
}

// ---------------------------------------------------------------------------
// the distributed iqn layouts. Own cilia = ownLocal positions in localCilia (ascending global id); own panel
// jj N_p + i = panel i of the jj-th own cilium. gatherOwnKinematics copies the own panels' x, V, t l and wrapped points
// out of the local arrays (find / eval query only these; nQ >= 1: a rank with no own cilia queries one dummy point
// so the collective find / eval still run). deviceHaloExchange fills o_fl: the own F scattered in, the halo F received
// from the owners (host-staged MPI, lists from setupOwnership).
// ---------------------------------------------------------------------------
int nOwn = 0, nOwnPanels = 0, nQ = 1;
occa::memory o_ownLoc, o_sendIdx, o_recvIdx, o_sbuf, o_rbuf;
std::vector<int> sendOff, recvOff;                // per nbrRank entry: first cilium in the send / receive buffer
std::vector<dfloat> h_sbuf, h_rbuf;

void setupDistributedIqn() {
  nOwn = ownLocal.size();
  nOwnPanels = nOwn * N_p;
  nQ = std::max(1, nOwnPanels);
  const size_t nl = std::max(1, kinPanels);
  o_xpc = platform->device.malloc<dfloat>(nl * 3);
  o_V   = platform->device.malloc<dfloat>(nl * 3);
  o_TL  = platform->device.malloc<dfloat>(nl * 4);
  o_px  = platform->device.malloc<dfloat>(nl);
  o_py  = platform->device.malloc<dfloat>(nl);
  o_pz  = platform->device.malloc<dfloat>(nl);
  o_fl  = platform->device.malloc<dfloat>(nl * 3);
  o_binPanel = platform->device.malloc<int>(nl);
  o_xo  = platform->device.malloc<dfloat>(nQ * 3);
  o_Vo  = platform->device.malloc<dfloat>(nQ * 3);
  o_TLo = platform->device.malloc<dfloat>(nQ * 4);
  o_pxo = platform->device.malloc<dfloat>(nQ);
  o_pyo = platform->device.malloc<dfloat>(nQ);
  o_pzo = platform->device.malloc<dfloat>(nQ);
  o_upc = platform->device.malloc<dfloat>(nQ * 3);
  o_f   = platform->device.malloc<dfloat>(nQ * 3);
  std::vector<dfloat> zeros(nQ * 4, 0.0), dummy(nQ, 0.0);
  o_f.copyFrom(zeros.data(), nQ * 3);
  dummy[0] = xmin;   // the dummy point of a rank with no own cilia: the box corner on the wall, as in setupOwnership
  o_pxo.copyFrom(dummy.data(), nQ);
  dummy[0] = ymin;
  o_pyo.copyFrom(dummy.data(), nQ);
  dummy[0] = 0.0;
  o_pzo.copyFrom(dummy.data(), nQ);
  std::vector<int> own(std::max(1, nOwn), 0);
  for (int j = 0; j < nOwn; j++) own[j] = ownLocal[j];
  o_ownLoc = platform->device.malloc<int>(own.size());
  o_ownLoc.copyFrom(own.data());

  // Halo exchange lists, flattened over the neighbours
  std::vector<int> sIdx, rIdx;
  sendOff.assign(nbrRank.size() + 1, 0);
  recvOff.assign(nbrRank.size() + 1, 0);
  for (size_t j = 0; j < nbrRank.size(); j++) {
    sIdx.insert(sIdx.end(), sendLocal[j].begin(), sendLocal[j].end());
    rIdx.insert(rIdx.end(), recvLocal[j].begin(), recvLocal[j].end());
    sendOff[j + 1] = sIdx.size();
    recvOff[j + 1] = rIdx.size();
  }
  const size_t w = 3 * N_p;
  o_sendIdx = platform->device.malloc<int>(std::max<size_t>(1, sIdx.size()));
  o_recvIdx = platform->device.malloc<int>(std::max<size_t>(1, rIdx.size()));
  if (!sIdx.empty()) o_sendIdx.copyFrom(sIdx.data());
  if (!rIdx.empty()) o_recvIdx.copyFrom(rIdx.data());
  o_sbuf = platform->device.malloc<dfloat>(std::max<size_t>(1, sIdx.size() * w));
  o_rbuf = platform->device.malloc<dfloat>(std::max<size_t>(1, rIdx.size() * w));
  h_sbuf.assign(sIdx.size() * w, 0.0);
  h_rbuf.assign(rIdx.size() * w, 0.0);
  if (platform->comm.mpiRank() == 0)
    printf("cilia: distributed iqn: own panels %d (rank 0), local %d; halo F exchange host-staged\n", nOwnPanels,
           kinPanels);
}

// Timers: every rank must tic/toc the same tags, also with no work (a rank with no own or local cilia), since
// nekRS's runtime statistics allreduce per tag; a tag missing on one rank deadlocks the print
void gatherOwnKinematics() {
  ptic("udfSource::gatherOwn");
  if (nOwn > 0) {
    ciliaGatherBlocks(nOwn, 3 * N_p, o_ownLoc, o_xpc, o_xo);
    ciliaGatherBlocks(nOwn, 3 * N_p, o_ownLoc, o_V, o_Vo);
    ciliaGatherBlocks(nOwn, 4 * N_p, o_ownLoc, o_TL, o_TLo);
    ciliaGatherBlocks(nOwn, N_p, o_ownLoc, o_px, o_pxo);
    ciliaGatherBlocks(nOwn, N_p, o_ownLoc, o_py, o_pyo);
    ciliaGatherBlocks(nOwn, N_p, o_ownLoc, o_pz, o_pzo);
  }
  ptoc("udfSource::gatherOwn");
}

// o_fl <- o_f (own, scattered) and the halo cilia's F from their owners. Called once per corrector, before the spread
void deviceHaloExchange() {
  ptic("udfSource::haloExchange");
  const int w = 3 * N_p;
  if (nOwn > 0) ciliaScatterBlocks(nOwn, w, o_ownLoc, o_f, o_fl);
  const int nSend = sendOff.back(), nRecv = recvOff.back();
  if (!nbrRank.empty()) {
    auto comm = platform->comm.mpiComm();
    if (nSend > 0) {
      ciliaGatherBlocks(nSend, w, o_sendIdx, o_fl, o_sbuf);
      o_sbuf.copyTo(h_sbuf.data(), (size_t)nSend * w);
    }
    std::vector<MPI_Request> req;
    for (size_t j = 0; j < nbrRank.size(); j++) {
      const int cnt = (recvOff[j + 1] - recvOff[j]) * w;
      if (cnt == 0) continue;
      req.emplace_back();
      MPI_Irecv(h_rbuf.data() + (size_t)recvOff[j] * w, cnt, MPI_DFLOAT, nbrRank[j], 31, comm, &req.back());
    }
    for (size_t j = 0; j < nbrRank.size(); j++) {
      const int cnt = (sendOff[j + 1] - sendOff[j]) * w;
      if (cnt == 0) continue;
      req.emplace_back();
      MPI_Isend(h_sbuf.data() + (size_t)sendOff[j] * w, cnt, MPI_DFLOAT, nbrRank[j], 31, comm, &req.back());
    }
    MPI_Waitall(req.size(), req.data(), MPI_STATUSES_IGNORE);
    if (nRecv > 0) {
      o_rbuf.copyFrom(h_rbuf.data(), (size_t)nRecv * w);
      ciliaScatterBlocks(nRecv, w, o_recvIdx, o_rbuf, o_fl);
    }
  }
  ptoc("udfSource::haloExchange");
}

// The own panels' entries (nc per panel) of a global-layout host vector
std::vector<dfloat> ownSlice(const std::vector<dfloat> &global, int nc) {
  const size_t w = (size_t)N_p * nc;
  std::vector<dfloat> v(nOwn * w);
  for (int j = 0; j < nOwn; j++) {
    const size_t g = localCilia[ownLocal[j]];
    std::copy(global.begin() + g * w, global.begin() + (g + 1) * w, v.begin() + j * w);
  }
  return v;
}

// Gather an own-layout host vector (nc entries per panel) to rank 0 in global panel order; empty on the other ranks
std::vector<dfloat> gatherOwnToRoot(const std::vector<dfloat> &slice, int nc) {
  auto comm = platform->comm.mpiComm();
  const size_t w = (size_t)N_p * nc;
  std::vector<int> cnt(nRanks, 0), disp(nRanks + 1, 0);
  for (int k = 0; k < N_cilia; k++) cnt[ciliumOwner[k]] += w;
  for (int r = 0; r < nRanks; r++) disp[r + 1] = disp[r] + cnt[r];
  std::vector<dfloat> all, out;
  if (myRank == 0) all.resize(disp[nRanks]);
  MPI_Gatherv(slice.data(), (int)slice.size(), MPI_DFLOAT, all.data(), cnt.data(), disp.data(), MPI_DFLOAT, 0, comm);
  if (myRank == 0) {
    out.resize((size_t)N_cilia * w);
    std::vector<int> next(disp.begin(), disp.end() - 1);
    for (int k = 0; k < N_cilia; k++) {
      const int r = ciliumOwner[k];
      std::copy(all.begin() + next[r], all.begin() + next[r] + w, out.begin() + (size_t)k * w);
      next[r] += w;
    }
  }
  return out;
}

// Fluid velocity at the located panel centres, component-major (u_pc[m + c N_part]); -999.0 marks lost points
std::vector<dfloat> samplePanelVelocity() {
  ptic("udfSource::eval");
  std::vector<dfloat> u_pc(N_part * 3, -999.0);
  o_upc.copyFrom(u_pc.data());
  interp->eval(nrs->meshV->dim, nrs->fluid->fieldOffset, nrs->fluid->o_U, N_part, o_upc, N_part);
  o_upc.copyTo(u_pc.data());
  ptoc("udfSource::eval");
  return u_pc;
}

// u_bg = u - (each cilium's own free-space flow from the force that produced u: sum_h c_h f_h spread at x_h)
void subtractOwnFlow(std::vector<dfloat> &u_pc, const std::vector<dfloat> &x_pc,
                     const std::vector<std::vector<dfloat>> &f_h, const std::vector<std::vector<dfloat>> &x_h,
                     const std::vector<dfloat> &c_h) {
  for (int k = 0; k < N_cilia; k++) {
    for (int i = 0; i < N_p; i++) {
      const int ii = k * N_p + i;
      if (u_pc[ii] == -999.0 && u_pc[ii + N_part] == -999.0 && u_pc[ii + 2 * N_part] == -999.0) continue;
      dfloat us[3] = {0.0, 0.0, 0.0};
      for (int h = 0; h < (int)c_h.size(); h++) {
        if (c_h[h] == 0.0) continue;
        const std::vector<dfloat> &fh = f_h[h], &xh = x_h[h];
        for (int j = 0; j < N_p; j++) {
          const int jj = k * N_p + j;
          dfloat d[3], r = 0.0;
          for (int c = 0; c < 3; c++) { d[c] = x_pc[ii*3 + c] - xh[jj*3 + c]; r += d[c] * d[c]; }
          r = sqrt(r);
          dfloat a, b;
          regStokeslet(r, a, b);
          a *= c_h[h]; b *= c_h[h];
          dfloat Fdotd = 0.0;
          for (int c = 0; c < 3; c++) Fdotd += fh[jj*3 + c] * d[c];
          for (int c = 0; c < 3; c++) us[c] += a * fh[jj*3 + c] + (r > 0 ? b * Fdotd * d[c] / (r * r) : 0.0);
        }
      }
      for (int c = 0; c < 3; c++) u_pc[ii + c * N_part] -= us[c] / mu_hat;
    }
  }
}

// f* = R(t) mu l (C_par V_par + C_perp V_perp) per panel, V = V_cilia - u (0 for lost panels): the force the panel
// exerts on the fluid
std::vector<dfloat> rftForce(const std::vector<dfloat> &tl_pc, const std::vector<dfloat> &V_cilia,
                             const std::vector<dfloat> &u_pc, dfloat R) {
  std::vector<dfloat> fstar(N_part * 3, 0.0);
  for(int k=0; k<N_cilia; k++) {
    for(int i=0; i<N_p; i++) {
      int idx = k * N_p + i;

      // Unit tangent t and panel length l from panelKinematics (panelLength)
      const dfloat tx = tl_pc[idx*4 + 0], ty = tl_pc[idx*4 + 1], tz = tl_pc[idx*4 + 2];

      dfloat Vx = 0.0, Vy = 0.0, Vz = 0.0;
      dfloat ux = u_pc[idx + 0 * N_part];
      dfloat uy = u_pc[idx + 1 * N_part];
      dfloat uz = u_pc[idx + 2 * N_part];

      if (ux != -999.0 || uy != -999.0 || uz != -999.0) {
          Vx = V_cilia[idx*3 + 0] - ux;
          Vy = V_cilia[idx*3 + 1] - uy;
          Vz = V_cilia[idx*3 + 2] - uz;
      }

      dfloat V_dot_t = Vx*tx + Vy*ty + Vz*tz;
      dfloat Vparx = V_dot_t * tx, Vpary = V_dot_t * ty, Vparz = V_dot_t * tz;
      dfloat Vperpx = Vx - Vparx,  Vperpy = Vy - Vpary,  Vperpz = Vz - Vparz;

      dfloat scale = R * mu_hat * tl_pc[idx*4 + 3];
      fstar[idx*3 + 0] = scale * (C_par*Vparx + C_perp*Vperpx);
      fstar[idx*3 + 1] = scale * (C_par*Vpary + C_perp*Vperpy);
      fstar[idx*3 + 2] = scale * (C_par*Vparz + C_perp*Vperpz);
    }
  }
  return fstar;
}

// Explicit coupling (couplingScheme = explicit): the force from u^n, relaxed, enters the next solve through o_EXT
void userForcing(double time) {
  if (N_part == 0 || couplingIQN) return;

  if (restoreForceHistory) {
    readForceHistory(time);
    restoreForceHistory = false;
  }

  const dfloat pi = 4.0 * atan(1.0);

  ptic("udfSource::kinematics");
  std::vector<dfloat> px, py, pz, x_pc, V_cilia, tl_pc;
  panelKinematics(time, x_pc, V_cilia, tl_pc, px, py, pz);
  ptoc("udfSource::kinematics");

  locatePanels(px, py, pz);
  std::vector<dfloat> u_pc = samplePanelVelocity();

  // the subtracted force is the one that produced u, sum_i c_i f_i spread at x_i
  // (f_old at the current positions alone gives an O(dt) error)
  std::vector<dfloat> c_ext(nrs->o_coeffEXT.size());
  nrs->o_coeffEXT.copyTo(c_ext.data());
  const bool dumpPanels = forcingCalls++ < dumpPanelSteps;
  const bool keepHist = subtractSelfFlow == 1 || dumpPanels;
  if (keepHist && f_hist.empty()) {   // first step (or restart): f_old is zero or nearly in place
    f_hist.assign(c_ext.size(), f_old);
    x_hist.assign(c_ext.size(), x_pc);
    c_hist.assign(c_ext.size(), 0.0);
    c_hist[0] = 1.0;
  }
  const std::vector<dfloat> u_raw = dumpPanels ? u_pc : std::vector<dfloat>();
  if (subtractSelfFlow == 1) subtractOwnFlow(u_pc, x_pc, f_hist, x_hist, c_hist);

  ptic("udfSource::panelForce");

  // Ramp R(t) and relaxation gamma = 2 pi f_c dt (dt-independent filter)
  const dfloat R = std::min((dfloat)1.0, (dfloat)(time / T_ramp));
  const dfloat gamma_relax = relaxNone ? (dfloat)1.0 : std::min((dfloat)1.0, (dfloat)(2.0 * pi * f_c * nrs->dt[0]));
  // cn: trapezoidal rule for df/dt = 2 pi f_c (f* - f), f_n = [(1 - g/2) f_old + (g/2)(f* + f*_old)] / (1 + g/2)
  const dfloat cn_a = (1.0 - 0.5 * gamma_relax) / (1.0 + 0.5 * gamma_relax);
  const dfloat cn_b = 0.5 * gamma_relax / (1.0 + 0.5 * gamma_relax);

  std::vector<dfloat> f(N_part * 3, 0.0);
  const std::vector<dfloat> fstar = (subtractSelfFlow == 2) ? implicitSelfFlowForce(x_pc, V_cilia, tl_pc, u_pc, R)
                                                            : rftForce(tl_pc, V_cilia, u_pc, R);

  for (int m = 0; m < N_part * 3; m++) {
    if (relaxCN) {
      f[m] = cn_a * f_old[m] + cn_b * (fstar[m] + fstar_old[m]);
    } else {  // euler; none has gamma = 1, so f = f*
      f[m] = (1.0 - gamma_relax) * f_old[m] + gamma_relax * fstar[m];
    }
    fstar_old[m] = fstar[m];
    f_old[m] = f[m];
  }

  // drag delivered vs RFT, sum over panels of f.V / (R mu C L_c), C for the rod's V direction
  if (kinematics == "rod" && platform->comm.mpiRank() == 0) {
    const int dv = rodVelocity[0] - 'x';
    const dfloat C = (rodAxis == rodVelocity) ? C_par : C_perp;
    const dfloat norm = std::max(R, (dfloat)1e-30) * mu_hat * C * L_c * N_cilia;
    dfloat Ff = 0, Fs = 0, ubar = 0;
    for (int m = 0; m < N_part; m++) {
      Ff += f[m*3 + dv];
      Fs += fstar_old[m*3 + dv];
      ubar += u_pc[m + dv * N_part] / N_part;
    }
    const int mid = N_p / 2;
    printf("%.10e %.10e %.10e %.10e %.10e  rod\n", time, Ff / norm, Fs / norm, ubar, u_pc[mid + dv * N_part]);
  }

  ptoc("udfSource::panelForce");

  ptic("udfSource::copyForces");
  o_xpc.copyFrom(x_pc.data());
  if (keepHist) {   // shift the history: this call's f, x enter o_EXT slot 0 with weight c_ext[0] next solve
    for (int h = (int)f_hist.size() - 1; h > 0; h--) { f_hist[h].swap(f_hist[h - 1]); x_hist[h].swap(x_hist[h - 1]); }
    f_hist[0] = f;
    x_hist[0] = x_pc;
    c_hist = c_ext;
  }
  o_f.copyFrom(f.data());
  ptoc("udfSource::copyForces");

  if (dumpPanels && platform->comm.mpiRank() == 0) {
    for (int m = 0; m < N_part; m++) {
      dfloat fa[3] = {0.0, 0.0, 0.0};
      for (int h = 0; h < (int)c_hist.size(); h++)
        for (int c = 0; c < 3; c++) fa[c] += c_hist[h] * f_hist[h][m*3 + c];
      printf("panel %d %.6e %d %d", forcingCalls, time, m / N_p, m % N_p);
      for (int c = 0; c < 3; c++) printf(" %.6e", fstar_old[m*3 + c]);
      for (int c = 0; c < 3; c++) printf(" %.6e", fa[c]);
      for (int c = 0; c < 3; c++) printf(" %.6e", u_raw[m + c * N_part]);
      for (int c = 0; c < 3; c++) printf(" %.6e", u_raw[m + c * N_part] - u_pc[m + c * N_part]);
      for (int c = 0; c < 3; c++) printf(" %.6e", V_cilia[m*3 + c]);
      printf("\n");
    }
    printf("panel_cext %d", forcingCalls);
    for (dfloat c : c_ext) printf(" %g", c);
    printf("\n");
  }

  occa::memory o_FU = nrs->fluid->o_explicitTerms();
  spreadForces(0, o_FU);
}

// ---------------------------------------------------------------------------
// Implicit coupling (couplingScheme = iqn). Per step, the unknown is F, the panel forces applied at x(t_{n+1});
// H(F) = C (V - u(F) + S F) is f* from the u that F produced (Stokes: H is affine in F within a step).
// IQN-ILS solves H(F) = F with secant pairs dR = r^{k+1} - r^k, dX = H^{k+1} - H^k (r = H(F) - F):
// c = argmin |dR c + r|, F^{k+1} = H(F^k) + dX c; pairs from the last couplingReuse steps are kept.
// The force is added straight into o_JwF (built once per step by makeForcing, read by the pressure and velocity
// solves), so o_EXT holds no cilia force and nothing is extrapolated.
// ---------------------------------------------------------------------------
// distributed. The unknown F lives on the OWN panels (n = 3 nOwnPanels per rank): the pool vectors, residual,
// least squares and update. Dot products are summed over the ranks (poolDots: reduce to rank 0 + broadcast, so every
// rank gets the same bits and takes the same decisions), and the small Gram / Cholesky solve is done on every rank.
// Each corrector the own F is scattered into the local layout and the halo F comes from the owners (deviceHaloExchange).
occa::memory o_JwF0;                                  // o_JwF without the cilia force, saved at corrector 1
std::vector<dfloat> iqnX, iqnV, iqnTL;                // host copies of x, V, t l at t_{n+1} (iqnCheck only)
// the iterate lives on the device. F^k is o_f; every other n-vector (n = 3 N_part) is a slot of one pool:
// fixed slots r, H of this corrector, r, H of the previous one (swapped each corrector), H of the converged step
// (restart file) and the converged F of the last steps (predictor); the rest hold secant pairs (dR, dX) from a free
// list. The QR of the secant columns is replaced by their Gram matrix G (dR_a . dR_b by slot, one new row per
// corrector): a Cholesky in the same newest-first order with the same filter gives the same R (L = R^T) and
// Q^T r = R^-T (dR^T r), so a corrector costs O(q n) on the device instead of O(q^2 n) on the host
occa::memory o_pool;
int poolCap = 0;
const int maxFconv = 3;
const int nFixedSlots = 8;
int sR = 0, sH = 1, sRp = 2, sHp = 3, sHconv = 4, sFconv[maxFconv] = {5, 6, 7};
int nFconv = 0;                                       // EXT order, set at the first step
std::vector<int> freeSlots;
std::vector<double> iqnG;                             // poolCap x poolCap; entries between dR slots only
std::vector<std::pair<int, int>> iqnCur;              // this step's secant pairs (dR slot, dX slot), oldest first
std::vector<std::vector<std::pair<int, int>>> iqnOld; // earlier steps' pairs, newest step first
occa::memory o_dotA, o_dotB, o_dotPart, o_cSlots, o_cCoef;   // staging for iqnPoolDots and iqnCombine
int iqnChecks = 0;
double iqnTime = 0;
dfloat iqnR = 0;
long iqnItersSum = 0, iqnSteps = 0, iqnMaxed = 0, iqnRestarts = 0;

// Diagnostic: how far the panel forces are from tile-periodic. partner[d][k] is the cilium whose root is
// cilium k's root shifted by one tile in x (d = 0) or y (d = 1), wrapped into the box; -1 if none
std::vector<int> tilePartner[2];
void tileAsymmetry(double time, const std::vector<dfloat> &F) {   // F: all panels, on rank 0 (empty elsewhere)
  if (myRank != 0) return;
  if (tilePartner[0].empty()) {
    for (int d = 0; d < 2; d++) {
      tilePartner[d].assign(N_cilia, -1);
      for (int k = 0; k < N_cilia; k++) {
        double x = xc[k] + (d == 0 ? tilePeriod : 0), y = yc[k] + (d == 1 ? tilePeriod : 0);
        x = xmin + fmod(fmod(x - xmin, Lx) + Lx, Lx);
        y = ymin + fmod(fmod(y - ymin, Ly) + Ly, Ly);
        for (int j = 0; j < N_cilia; j++) {
          double dx = fabs(xc[j] - x), dy = fabs(yc[j] - y);
          dx = std::min(dx, Lx - dx); dy = std::min(dy, Ly - dy);
          if (dx < 1e-9 && dy < 1e-9) { tilePartner[d][k] = j; break; }
        }
      }
    }
  }
  double a[2] = {0, 0}, fn = 0;
  for (int k = 0; k < N_cilia; k++)
    for (int m = 0; m < N_p * 3; m++) {
      const double f = F[k * N_p * 3 + m];
      fn += f * f;
      for (int d = 0; d < 2; d++) {
        const int j = tilePartner[d][k];
        if (j < 0) continue;
        const double df = f - F[j * N_p * 3 + m];
        a[d] += df * df;
      }
    }
  const double s = fn > 0 ? 1.0 / sqrt(fn) : 0.0;
  if (platform->comm.mpiRank() == 0)
    printf("%.10e %.3e %.3e  tileasym\n", time, sqrt(a[0]) * s, sqrt(a[1]) * s);
}

dfloat vdot(const std::vector<dfloat> &a, const std::vector<dfloat> &b) {
  dfloat s = 0.0;
  for (size_t m = 0; m < a.size(); m++) s += a[m] * b[m];
  return s;
}

// Pool helpers. Slots keep their index when the pool grows (doubling)
void poolReserve(int cap) {
  const int n = 3 * nOwnPanels;
  if (cap <= poolCap) return;
  nekrsCheck((double)cap * n >= 2147483647.0, platform->comm.mpiComm(), EXIT_FAILURE,
             "IQN pool of %d x %d exceeds the int index range\n", cap, n);
  occa::memory o_new = platform->device.malloc<dfloat>(std::max<size_t>((size_t)cap * n, 1));
  if (poolCap > 0 && n > 0) o_new.copyFrom(o_pool, (size_t)poolCap * n);
  o_pool = o_new;
  std::vector<double> G((size_t)cap * cap, 0.0);
  for (int a = 0; a < poolCap; a++)
    for (int b = 0; b < poolCap; b++) G[(size_t)a * cap + b] = iqnG[(size_t)a * poolCap + b];
  iqnG.swap(G);
  for (int s = cap - 1; s >= std::max(poolCap, nFixedSlots); s--) freeSlots.push_back(s);
  poolCap = cap;
}

int newSlot() {
  if (freeSlots.empty()) poolReserve(2 * poolCap);
  const int s = freeSlots.back();
  freeSlots.pop_back();
  return s;
}

void freePairs(const std::vector<std::pair<int, int>> &P) {
  for (const auto &p : P) { freeSlots.push_back(p.first); freeSlots.push_back(p.second); }
}

double &iqnGram(int a, int b) { return iqnG[(size_t)a * poolCap + b]; }

template <typename T> void ensureSize(occa::memory &o, size_t count) {
  if (!o.isInitialized() || o.size() < count) o = platform->device.malloc<T>(std::max(count, (size_t)256));
}

std::vector<dfloat> poolGet(int s) {
  std::vector<dfloat> v(3 * nOwnPanels);
  o_pool.copyTo(v.data(), v.size(), (size_t)s * v.size());
  return v;
}

// Dot products of pool slots A[p] . B[p] on the device; the chunk partials are summed on the host in order, then over
// the ranks (reduce to rank 0 and broadcast: every rank holds the same bits, so the Cholesky and the stop test agree)
std::vector<double> poolDots(const std::vector<int> &A, const std::vector<int> &B) {
  const int n = 3 * nOwnPanels, np = A.size();
  const int nChunk = std::max(1, std::min(64, (n + 4095) / 4096));
  std::vector<double> d(np, 0.0);
  if (n > 0) {
    ensureSize<int>(o_dotA, np);
    ensureSize<int>(o_dotB, np);
    ensureSize<dfloat>(o_dotPart, (size_t)np * nChunk);
    o_dotA.copyFrom(A.data(), np);
    o_dotB.copyFrom(B.data(), np);
    iqnPoolDots(n, np, nChunk, o_dotA, o_dotB, o_pool, o_dotPart);
    std::vector<dfloat> part((size_t)np * nChunk);
    o_dotPart.copyTo(part.data(), part.size());
    for (int p = 0; p < np; p++)
      for (int c = 0; c < nChunk; c++) d[p] += part[(size_t)p * nChunk + c];
  }
  if (nRanks > 1) {
    auto comm = platform->comm.mpiComm();
    MPI_Reduce(myRank == 0 ? MPI_IN_PLACE : d.data(), d.data(), np, MPI_DOUBLE, MPI_SUM, 0, comm);
    MPI_Bcast(d.data(), np, MPI_DOUBLE, 0, comm);
  }
  return d;
}

// out = a0 base + sum_j coef[j] slot_j, base = pool slot baseSlot or out itself (baseSlot < 0)
void poolCombine(occa::memory &o_out, dfloat a0, int baseSlot, const std::vector<int> &slots,
                 const std::vector<dfloat> &coef) {
  const int n = 3 * nOwnPanels, q = slots.size();
  if (n == 0) return;
  ensureSize<int>(o_cSlots, std::max(q, 1));
  ensureSize<dfloat>(o_cCoef, std::max(q, 1));
  if (q > 0) { o_cSlots.copyFrom(slots.data(), q); o_cCoef.copyFrom(coef.data(), q); }
  iqnCombine(n, a0, baseSlot >= 0 ? (dlong)baseSlot * n : (dlong)-1, q, o_cSlots, o_cCoef, o_pool, o_out);
}

dfloat relMaxDiff(const std::vector<dfloat> &a, const std::vector<dfloat> &ref) {
  dfloat d = 0.0, m = 0.0;
  for (size_t i = 0; i < a.size(); i++) { d = std::max(d, (dfloat)std::abs(a[i] - ref[i])); m = std::max(m, (dfloat)std::abs(ref[i])); }
  return m > 0 ? d / m : d;
}

// The earlier host update (from before the iterate moved to the device), kept for iqnCheck: QR of the candidate columns (newest first) by modified Gram-Schmidt
// (twice), dropping columns nearly dependent on the newer ones; F = H + W c, c = -R^{-1} Q^T r, or F + omega r
std::vector<dfloat> iqnSolveMGS(const std::vector<std::vector<dfloat>> &candR, const std::vector<std::vector<dfloat>> &candX,
                                const std::vector<dfloat> &r, const std::vector<dfloat> &H, const std::vector<dfloat> &F,
                                int &q) {
  const int n = r.size();
  std::vector<std::vector<dfloat>> Q, Rm;   // Rm[j] = column j of R (length j + 1)
  std::vector<const std::vector<dfloat>*> W;
  for (size_t j = 0; j < candR.size() && (int)Q.size() < n; j++) {
    std::vector<dfloat> w = candR[j];
    const dfloat vn = sqrt(vdot(w, w));
    if (vn == 0.0) continue;
    std::vector<dfloat> rc(Q.size() + 1, 0.0);
    for (int pass = 0; pass < 2; pass++)
      for (size_t i = 0; i < Q.size(); i++) {
        const dfloat p = vdot(Q[i], w);
        rc[i] += p;
        for (int m = 0; m < n; m++) w[m] -= p * Q[i][m];
      }
    const dfloat wn = sqrt(vdot(w, w));
    if (wn < couplingFilter * vn) continue;
    for (int m = 0; m < n; m++) w[m] /= wn;
    rc[Q.size()] = wn;
    Q.push_back(w);
    Rm.push_back(rc);
    W.push_back(&candX[j]);
  }
  q = Q.size();
  std::vector<dfloat> out;
  if (Q.empty()) {
    out = F;
    for (int m = 0; m < n; m++) out[m] += couplingOmega * r[m];
  } else {
    std::vector<dfloat> c(q);
    for (int i = 0; i < q; i++) c[i] = -vdot(Q[i], r);
    for (int i = q - 1; i >= 0; i--) {
      for (int j = i + 1; j < q; j++) c[i] -= Rm[j][i] * c[j];
      c[i] /= Rm[i][i];
    }
    out = H;
    for (int j = 0; j < q; j++)
      for (int m = 0; m < n; m++) out[m] += c[j] * (*W[j])[m];
  }
  return out;
}

// nrs->preFluid: before each corrector's fluid solve
void ciliaPreFluid(double time, int tstep) {
  if (N_part == 0 || !couplingIQN) return;
  const int iter = nrs->outerCorrector;
  const int n = 3 * nOwnPanels;

  if (iter == 1) {
    if (restoreForceHistory) {
      readForceHistory(time);
      restoreForceHistory = false;
    }
    iqnTime = time;
    iqnR = std::min((dfloat)1.0, (dfloat)(time / T_ramp));
    deviceKinematics(time);   // x, V, t l, the wrapped points and the bins of the local cilia, on the device
    if (kinChecks < kinematicsCheck) { kinChecks++; kinematicsCompare(time); }
    gatherOwnKinematics();    // find / eval and the panel force use the own panels only
    ptic("udfSource::find");
    interp->setPoints(o_pxo, o_pyo, o_pzo);
    interp->find();
    ptoc("udfSource::find");

    // Predictor: extrapolate the converged forces with nekRS's EXT coefficients for this step
    std::vector<dfloat> c_ext(nrs->o_coeffEXT.size());
    nrs->o_coeffEXT.copyTo(c_ext.data());
    if (poolCap == 0) poolReserve(nFixedSlots + 8 * (couplingReuse + 1));
    if (nFconv == 0) {   // first step (or restart): f_old is zero or the restored force
      nFconv = c_ext.size();
      nekrsCheck(nFconv > maxFconv, platform->comm.mpiComm(), EXIT_FAILURE, "EXT order %d > %d\n", nFconv, maxFconv);
      const std::vector<dfloat> fOwn = ownSlice(f_old, 3);
      for (int h = 0; h < nFconv; h++)
        if (n > 0) o_pool.copyFrom(fOwn.data(), n, (size_t)sFconv[h] * n);
    }
    poolCombine(o_f, 0.0, -1, std::vector<int>(sFconv, sFconv + nFconv), c_ext);

    freePairs(iqnCur);   // empty: a step ends by moving them to iqnOld
    iqnCur.clear();
    if (!o_JwF0.isInitialized()) o_JwF0 = platform->device.malloc<dfloat>(nrs->fluid->o_JwF.size());   // typed: size() counts dfloats
    o_JwF0.copyFrom(nrs->fluid->o_JwF);
  }

  deviceHaloExchange();
  spreadForces(1, nrs->fluid->o_JwF, &o_JwF0);   // o_JwF = o_JwF0 + spread, no copy first
}

// nrs->userConvergenceCheck: after each corrector's fluid solve; true ends the step
bool ciliaConverged(int iter) {
  if (N_part == 0 || !couplingIQN) return true;
  const int n = 3 * nOwnPanels;
  const bool check = iqnChecks < iqnCheck;   // iqnCheck: 1 rank only (own = all cilia; checked at setup)
  if (check) iqnChecks++;

  ptic("udfSource::eval");
  platform->linAlg->fill(3 * nQ, -999.0, o_upc);
  interp->eval(nrs->meshV->dim, nrs->fluid->fieldOffset, nrs->fluid->o_U, nQ, o_upc, nQ);
  ptoc("udfSource::eval");

  ptic("udfSource::panelForce");   // includes the self-flow subtraction (was udfSource::selfFlow, host)
  const dfloat pi = 4.0 * atan(1.0);
  if (nOwnPanels > 0)
    ciliaPanelForce(nOwnPanels, N_p, o_xo, o_Vo, o_TLo, o_upc, o_f, subtractSelfFlow == 1 ? 1 : 0, iqnR, mu_hat, C_par,
                    C_perp, epsilon, kernel2, pi, (dlong)sH * n, o_pool);
  ptoc("udfSource::panelForce");

  // iqnCheck: the host path (eval copy, subtractOwnFlow, rftForce) on the same u and F
  dfloat errH = 0.0;
  std::vector<dfloat> Fhost;
  if (check) {
    std::vector<dfloat> u(n);
    o_upc.copyTo(u.data(), n);
    Fhost.resize(n);
    o_f.copyTo(Fhost.data(), n);
    iqnX.resize(n); iqnV.resize(n); iqnTL.resize(4 * N_part);   // the kinematics live on the device
    o_xo.copyTo(iqnX.data(), n);
    o_Vo.copyTo(iqnV.data(), n);
    o_TLo.copyTo(iqnTL.data(), 4 * N_part);
    if (subtractSelfFlow == 1) subtractOwnFlow(u, iqnX, {Fhost}, {iqnX}, {1.0});
    errH = relMaxDiff(poolGet(sH), rftForce(iqnTL, iqnV, u, iqnR));
  }

  ptic("udfSource::iqnUpdate");   // residual, history, least squares, update; stopped on both returns
  int sDR = 0, sDX = 0;
  if (iter > 1) { sDR = newSlot(); sDX = newSlot(); }
  if (n > 0)
    iqnResidual(n, iter > 1 ? 1 : 0, (dlong)sH * n, (dlong)sR * n, (dlong)sHp * n, (dlong)sRp * n, (dlong)sDR * n,
                (dlong)sDX * n, o_f, o_pool);
  if (iter > 1) iqnCur.push_back({sDR, sDX});

  // One launch: r.r, H.H, r.dR for every live column, and the new dR with every live column (a new row of G)
  std::vector<int> live;
  for (const auto &p : iqnCur) live.push_back(p.first);
  for (const auto &s : iqnOld) for (const auto &p : s) live.push_back(p.first);
  std::vector<int> A = {sR, sH}, B = {sR, sH};
  for (int s : live) { A.push_back(sR); B.push_back(s); }
  if (iter > 1) for (int s : live) { A.push_back(sDR); B.push_back(s); }
  const std::vector<double> d = poolDots(A, B);
  const size_t nl = live.size();
  std::vector<double> rdot(poolCap, 0.0);   // r . dR by slot
  for (size_t j = 0; j < nl; j++) rdot[live[j]] = d[2 + j];
  if (iter > 1)
    for (size_t j = 0; j < nl; j++) iqnGram(sDR, live[j]) = iqnGram(live[j], sDR) = d[2 + nl + j];
  const dfloat rn = sqrt(d[0]), Hn = sqrt(d[1]);

  const bool converged = rn <= couplingTol * Hn;
  if (iqnVerbose && platform->comm.mpiRank() == 0)
    printf("%.10e %d %.3e  iqnres\n", iqnTime, iter, Hn > 0 ? rn / Hn : 0.0);
  if (converged || iter >= couplingMaxIter) {
    for (int h = nFconv - 1; h > 0; h--) std::swap(sFconv[h], sFconv[h - 1]);
    if (n > 0) o_pool.copyFrom(o_f, n, (size_t)sFconv[0] * n, 0);   // the force the converged u came from (restart file: f_old)
    std::swap(sH, sHconv);                               // its H (fstar_old)
    if (couplingReuse > 0) {
      iqnOld.insert(iqnOld.begin(), iqnCur);
      if ((int)iqnOld.size() > couplingReuse) { freePairs(iqnOld.back()); iqnOld.pop_back(); }
    } else {
      freePairs(iqnCur);
    }
    iqnCur.clear();
    iqnItersSum += iter;
    iqnSteps++;
    if (!converged) iqnMaxed++;
    if (tilePeriod > 0) {
      std::vector<dfloat> F(n);
      if (n > 0) o_f.copyTo(F.data(), n);
      tileAsymmetry(iqnTime, gatherOwnToRoot(F, 3));   // global F on rank 0
    }
    if (platform->comm.mpiRank() == 0) {
      printf("%.10e %d %.3e %ld  iqn\n", iqnTime, iter, Hn > 0 ? rn / Hn : 0.0, iqnMaxed);
      if (check) printf("%d %d %.3e %.3e %d %d  iqncheck\n", iqnChecks, iter, errH, 0.0, -1, -1);
    }
    ptoc("udfSource::iqnUpdate");
    return true;
  }

  // restart: the earlier steps' pairs have gone stale (the Jacobian moved); go on with this step's only
  if (couplingRestart > 0 && iter == couplingRestart) {
    for (const auto &s : iqnOld) freePairs(s);
    iqnOld.clear();
    iqnRestarts++;
    if (platform->comm.mpiRank() == 0) printf("%.10e %d %ld  iqnrestart\n", iqnTime, iter, iqnRestarts);
  }

  // Secant columns, newest first: this step's, then the earlier steps'
  std::vector<std::pair<int, int>> cand;
  for (int j = (int)iqnCur.size() - 1; j >= 0; j--) cand.push_back(iqnCur[j]);
  for (const auto &s : iqnOld)
    for (int j = (int)s.size() - 1; j >= 0; j--) cand.push_back(s[j]);

  // Filtered Cholesky of G in that order: column j is kept if its part orthogonal to the kept newer ones,
  // sqrt(G_jj - |l|^2), is at least couplingFilter |dR_j| (the MGS test)
  std::vector<int> keptR, keptX;
  std::vector<std::vector<double>> L;   // L[i] = row i of R^T (length i + 1)
  for (const auto &p : cand) {
    if ((int)keptR.size() >= n) break;
    const double g = iqnGram(p.first, p.first);
    if (g == 0.0) continue;
    const size_t q = keptR.size();
    std::vector<double> l(q + 1);
    double dd = g;
    for (size_t i = 0; i < q; i++) {
      double v = iqnGram(p.first, keptR[i]);
      for (size_t m = 0; m < i; m++) v -= L[i][m] * l[m];
      l[i] = v / L[i][i];
      dd -= l[i] * l[i];
    }
    if (!(dd > 0.0) || sqrt(dd) < couplingFilter * sqrt(g)) continue;
    l[q] = sqrt(dd);
    L.push_back(l);
    keptR.push_back(p.first);
    keptX.push_back(p.second);
  }

  std::vector<dfloat> Fref;
  int qMGS = 0;
  if (check) {
    std::vector<std::vector<dfloat>> cR, cX;
    for (const auto &p : cand) { cR.push_back(poolGet(p.first)); cX.push_back(poolGet(p.second)); }
    Fref = iqnSolveMGS(cR, cX, poolGet(sR), poolGet(sH), Fhost, qMGS);
  }

  const int q = keptR.size();
  if (q == 0) {
    poolCombine(o_f, 1.0, -1, {sR}, {couplingOmega});
  } else {
    // z = Q^T r = R^-T (dR^T r); c = -R^-1 z; F = H + dX c
    std::vector<double> z(q), c(q);
    for (int i = 0; i < q; i++) {
      double v = rdot[keptR[i]];
      for (int m = 0; m < i; m++) v -= L[i][m] * z[m];
      z[i] = v / L[i][i];
    }
    for (int i = q - 1; i >= 0; i--) {
      double v = -z[i];
      for (int j = i + 1; j < q; j++) v -= L[j][i] * c[j];
      c[i] = v / L[i][i];
    }
    poolCombine(o_f, 1.0, sH, keptX, std::vector<dfloat>(c.begin(), c.end()));
  }
  std::swap(sR, sRp);
  std::swap(sH, sHp);
  ptoc("udfSource::iqnUpdate");

  if (check) {
    std::vector<dfloat> F(n);
    o_f.copyTo(F.data(), n);
    if (platform->comm.mpiRank() == 0)
      printf("%d %d %.3e %.3e %d %d  iqncheck\n", iqnChecks, iter, errH, relMaxDiff(F, Fref), q, qMGS);
  }
  return false;
}

// ---------------------------------------------------------------------------
// Plane integrals for the 'wall' line, replacing the ParaView slice + IntegrateVariables pass.
// On the genbox mesh (axis-aligned elements, local i -> x, j -> y, k -> z) the integral of f over
// z = z0 is sum_n W[n] f[n] with W = w_i w_j (dx dy / 4) l_k(r0) for nodes of the element layer
// holding z0 (r0 = 2 (z0 - zmin)/dz - 1). Using l_k'(r0) 2/dz instead gives the integral of df/dz.
// Both are exact spectral interpolation; each integral is one innerProd on the device.
// ---------------------------------------------------------------------------
occa::memory o_Wplane, o_WplaneDz, o_Wwall, o_WwallDz;
dfloat planeArea = 0;

void setupPlaneWeights(dfloat z0, occa::memory &o_W, occa::memory &o_WDz, dfloat &area) {
  auto mesh = nrs->meshV;
  const int Nq = mesh->Nq;
  const dfloat *r = mesh->gllz, *w = mesh->gllw;
  auto [x, y, z] = mesh->xyzHost();
  std::vector<dfloat> W(mesh->Nlocal, 0.0), WDz(mesh->Nlocal, 0.0);
  std::vector<dfloat> l(Nq), dl(Nq);
  const dfloat tol = 1e-8;
  double a = 0;
  for (dlong e = 0; e < mesh->Nelements; ++e) {
    const dlong o = e * mesh->Np;
    const dfloat zmin = z[o], zmax = z[o + (Nq - 1) * Nq * Nq];
    if (!(zmin - tol <= z0 && z0 < zmax - tol)) continue;
    const dfloat dx = x[o + Nq - 1] - x[o], dy = y[o + (Nq - 1) * Nq] - y[o], dz = zmax - zmin;
    for (int n = 0; n < mesh->Np; ++n) {  // assumes the genbox layout described above
      const int i = n % Nq, j = (n / Nq) % Nq, k = n / (Nq * Nq);
      if (std::abs(x[o + n] - (x[o] + dx * (r[i] + 1) / 2)) > tol * (1 + std::abs(x[o])) ||
          std::abs(y[o + n] - (y[o] + dy * (r[j] + 1) / 2)) > tol * (1 + std::abs(y[o])) ||
          std::abs(z[o + n] - (zmin + dz * (r[k] + 1) / 2)) > tol * (1 + std::abs(zmin))) {
        printf("[ERROR] wall integrals need axis-aligned genbox elements (element %d)\n", (int)e);
        std::abort();
      }
    }
    const dfloat r0 = 2 * (z0 - zmin) / dz - 1;
    for (int k = 0; k < Nq; ++k) {  // Lagrange basis l_k and its derivative at r0
      l[k] = 1; dl[k] = 0;
      for (int b = 0; b < Nq; ++b) if (b != k) l[k] *= (r0 - r[b]) / (r[k] - r[b]);
      for (int c = 0; c < Nq; ++c) {
        if (c == k) continue;
        dfloat term = 1 / (r[k] - r[c]);
        for (int b = 0; b < Nq; ++b) if (b != k && b != c) term *= (r0 - r[b]) / (r[k] - r[b]);
        dl[k] += term;
      }
    }
    for (int n = 0; n < mesh->Np; ++n) {
      const int i = n % Nq, j = (n / Nq) % Nq, k = n / (Nq * Nq);
      const dfloat wxy = w[i] * w[j] * dx * dy / 4;
      W[o + n] = wxy * l[k];
      WDz[o + n] = wxy * dl[k] * 2 / dz;
      a += wxy * l[k];
    }
  }
  MPI_Allreduce(MPI_IN_PLACE, &a, 1, MPI_DOUBLE, MPI_SUM, platform->comm.mpiComm());
  area = a;
  o_W = platform->device.malloc(mesh->Nlocal * sizeof(dfloat));
  o_WDz = platform->device.malloc(mesh->Nlocal * sizeof(dfloat));
  o_W.copyFrom(W.data(), mesh->Nlocal * sizeof(dfloat));
  o_WDz.copyFrom(WDz.data(), mesh->Nlocal * sizeof(dfloat));
}

// One 'vals' and one 'wall' line per call, on rank 0 (gate.py reads both).
// one diagReduce kernel and one copy instead of 10 separate device reductions.
occa::memory o_diag;
std::vector<dfloat> diagPartial;

void printDiagnostics(double time) {
  auto mesh = nrs->meshV;
  auto comm = platform->comm.mpiComm();
  const int nq = 10;

  if (!o_diag.isInitialized()) {
    diagPartial.resize(mesh->Nelements * nq);
    o_diag = platform->device.malloc(diagPartial.size() * sizeof(dfloat));
  }
  diagReduce(mesh->Nelements, nrs->fluid->fieldOffset, mesh->o_Jw, nrs->fluid->o_U, nrs->fluid->o_P,
             o_Wplane, o_WplaneDz, o_Wwall, o_WwallDz, o_diag);
  o_diag.copyTo(diagPartial.data(), diagPartial.size() * sizeof(dfloat));

  double sum[nq - 1] = {0}, vmax = 0;
  for (dlong e = 0; e < mesh->Nelements; ++e) {
    for (int q = 0; q < nq - 1; ++q) sum[q] += diagPartial[e * nq + q];
    vmax = std::max(vmax, (double)diagPartial[e * nq + nq - 1]);
  }
  MPI_Allreduce(MPI_IN_PLACE, sum, nq - 1, MPI_DOUBLE, MPI_SUM, comm);
  MPI_Allreduce(MPI_IN_PLACE, &vmax, 1, MPI_DOUBLE, MPI_MAX, comm);

  const dfloat ubar = sum[0] / mesh->volume, Vmax = vmax;
  // Plane integrals in code units (tau = du/dz, no mu)
  const dfloat Iu = sum[1], Iv = sum[2], Ip = sum[3], Iudz = sum[4], Ivdz = sum[5];
  const dfloat Ipw = sum[6], Iudzw = sum[7], Ivdzw = sum[8];

  if (platform->comm.mpiRank() == 0) {
    printf("%.10e %.10e %.10e  vals\n", time, ubar, Vmax);
    // time | z = wallPlaneZ: int u, int v, int p, int du/dz, int dv/dz | z = 0: int p, int du/dz, int dv/dz
    printf("%.10e %.10e %.10e %.10e %.10e %.10e %.10e %.10e %.10e  wall\n",
           time, Iu, Iv, Ip, Iudz, Ivdz, Ipw, Iudzw, Ivdzw);
  }
}

// Workaround for a nekRS v26.0 bug, https://github.com/Nek5000/nekRS/issues/722: divergenceSurfaceHex3D (pressure rhs) reads the averaged normal
// (sgeo slots NXAVGID..NZAVGID = 15..17, mesh3D.h) on zeroDirichletX/Y/Z faces too, but only setAvgNormal
// writes those slots, and it runs only for unaligned (zeroDirichletN) faces. On aligned faces they hold
// uninitialized device memory, so copy the face normal (slots NXID..NZID = 0..2) there. Static mesh only.
void fixAlignedAvgNormals() {
  auto mesh = nrs->meshV;
  const auto &field = nrs->fluid->velocityName;
  const int nxid = 0, nxavgid = 15;
  const dlong Nface = mesh->Nfp * mesh->Nsgeo;
  std::vector<dfloat> sgeo(mesh->Nelements * mesh->Nfaces * Nface);
  mesh->o_sgeo.copyTo(sgeo.data(), sgeo.size());

  int nfix = 0;
  dfloat maxDiff = 0;
  for (dlong e = 0; e < mesh->Nelements; e++) {
    for (int f = 0; f < mesh->Nfaces; f++) {
      const int bid = mesh->EToB[e * mesh->Nfaces + f];
      if (bid < 1) continue;
      const int t = platform->app->bc->typeId(bid, field);
      if (!(t == bdryBase::bcType_zeroDirichletX_zeroNeumann || t == bdryBase::bcType_zeroDirichletX_udfNeumann ||
            t == bdryBase::bcType_zeroDirichletY_zeroNeumann || t == bdryBase::bcType_zeroDirichletY_udfNeumann ||
            t == bdryBase::bcType_zeroDirichletZ_zeroNeumann || t == bdryBase::bcType_zeroDirichletZ_udfNeumann))
        continue;
      for (int m = 0; m < mesh->Nfp; m++) {
        dfloat *s = &sgeo[(e * mesh->Nfaces + f) * Nface + m * mesh->Nsgeo];
        for (int d = 0; d < 3; d++) {
          maxDiff = std::max(maxDiff, (dfloat)std::abs(s[nxavgid + d] - s[nxid + d]));
          s[nxavgid + d] = s[nxid + d];
        }
      }
      nfix++;
    }
  }
  mesh->o_sgeo.copyFrom(sgeo.data(), sgeo.size());

  MPI_Allreduce(MPI_IN_PLACE, &nfix, 1, MPI_INT, MPI_SUM, platform->comm.mpiComm());
  MPI_Allreduce(MPI_IN_PLACE, &maxDiff, 1, MPI_DFLOAT, MPI_MAX, platform->comm.mpiComm());
  if (platform->comm.mpiRank() == 0 && nfix > 0)
    printf("cilia: fixAlignedAvgNormals: %d aligned faces, max |n_avg - n| before = %g\n", nfix, maxDiff);
}

void UDF_Setup() {
  int rank;
  MPI_Comm_rank(platform->comm.mpiComm(), &rank);

  readCaseData();

  // the legacy paths hold all panels on every rank: one rank only
  {
    int size;
    MPI_Comm_size(platform->comm.mpiComm(), &size);
    nekrsCheck(size > 1 && (!couplingIQN || subtractSelfFlow == 2 || dumpPanelSteps > 0), platform->comm.mpiComm(),
               EXIT_FAILURE, "%s\n", "explicit coupling, subtractSelfFlow = 2 and dumpPanelSteps run on 1 rank only");
    nekrsCheck(size > 1 && iqnCheck > 0, platform->comm.mpiComm(), EXIT_FAILURE, "%s\n",
               "iqnCheck runs on 1 rank only (kinematicsCheck and binningCheck work on any number)");
  }

  if(rank == 0) {
    std::ifstream infile(coordinatesFile);
    if (!infile.good()) {
        std::cerr << "\n[ERROR] " << coordinatesFile << " not found!\n" << std::endl;
    } else {
        // First three columns are x_root y_root beta; extra columns are ignored
        std::string line;
        while (std::getline(infile, line)) {
          std::istringstream ls(line);
          dfloat x, y, b;
          if (!(ls >> x >> y >> b)) continue;
          xc.push_back(x);
          yc.push_back(y);
          beta_c.push_back(b);
          N_cilia++;
        }
    }
  }

  MPI_Bcast(&N_cilia, 1, MPI_INT, 0, platform->comm.mpiComm());
  if(rank != 0) {
    xc.resize(N_cilia); yc.resize(N_cilia); beta_c.resize(N_cilia);
  }
  MPI_Bcast(xc.data(), N_cilia, MPI_DFLOAT, 0, platform->comm.mpiComm());
  MPI_Bcast(yc.data(), N_cilia, MPI_DFLOAT, 0, platform->comm.mpiComm());
  MPI_Bcast(beta_c.data(), N_cilia, MPI_DFLOAT, 0, platform->comm.mpiComm());

  N_part = N_cilia * N_p;

  const dfloat pi = 4.0 * atan(1.0);
  C_par  = 2.0 * pi / log(slenderness);
  C_perp = 4.0 * pi / log(slenderness);
  l_panel = L_c / N_p;
  epsinv2 = 1.0 / (epsilon * epsilon);
  rcut2   = (rcutFactor * epsilon) * (rcutFactor * epsilon);
  invnorm = 1.0 / (epsilon * epsilon * epsilon * pow(pi, 1.5));

  auto mesh = nrs->meshV;
  xmin = platform->linAlg->min(mesh->Nlocal, mesh->o_x, platform->comm.mpiComm());
  ymin = platform->linAlg->min(mesh->Nlocal, mesh->o_y, platform->comm.mpiComm());
  Lx = platform->linAlg->max(mesh->Nlocal, mesh->o_x, platform->comm.mpiComm()) - xmin;
  Ly = platform->linAlg->max(mesh->Nlocal, mesh->o_y, platform->comm.mpiComm()) - ymin;
  if (2 * rcutFactor * epsilon >= std::min(Lx, Ly)) {
    if (rank == 0) printf("[ERROR] r_cut must be below half the box for the minimum image\n");
    std::abort();
  }

  if (rank == 0) {
    printf("cilia: coordinatesFile = %s  (N_cilia = %d, N_part = %d)\n", coordinatesFile.c_str(), N_cilia, N_part);
    printf("cilia: N_p = %d  l = %g  L/r = %g  C_par = %g  C_perp = %g  mu = %g\n",
           N_p, l_panel, slenderness, C_par, C_perp, mu_hat);
    printf("cilia: periodic box x = [%g, %g], y = [%g, %g]\n", xmin, xmin + Lx, ymin, ymin + Ly);
    if (kinematics == "rod")
      printf("cilia: rod test: axis %s, velocity 1 along %s, centre z = %g; 'rod' lines: time, sum f.V/(mu C L), same for f*, mean u.V, mid-panel u.V\n",
             rodAxis.c_str(), rodVelocity.c_str(), rodCentreZ);
    printf("cilia: subtractSelfFlow = %d  dumpPanelSteps = %d  panelLength = %s\n", subtractSelfFlow, dumpPanelSteps,
           panelLength.c_str());
    printf("cilia: couplingScheme = %s  tol = %g  maxIter = %d  omega = %g  reuse = %d  restart = %d  filter = %g%s\n",
           couplingScheme.c_str(), couplingTol, couplingMaxIter, couplingOmega, couplingReuse, couplingRestart, couplingFilter,
           couplingIQN ? "; 'iqn' lines: time, correctors, |f* - F|/|f*|, steps at maxIter so far" : "");
    if (couplingIQN && iqnCheck > 0)
      printf("cilia: iqnCheck = %d ('iqncheck' lines: call, corrector, max|H - H_host|/max|H_host|, max|F - F_MGS|/max|F_MGS|, columns kept: Gram, MGS)\n", iqnCheck);
    printf("cilia: gaussianKernel = %s\n", gaussianKernel.c_str());
    printf("cilia: epsilon = %g  r_cut = %g epsilon  T_ramp = %g  f_c = %g  f_beat = %g  L_c = %g  relaxScheme = %s\n",
           epsilon, rcutFactor, T_ramp, f_c, f_beat, L_c, relaxScheme.c_str());
  }

  f_old.assign(N_part * 3, 0.0);
  fstar_old.assign(N_part * 3, 0.0);

  if (N_part > 0 && !couplingIQN) {   // iqn: setupDistributedIqn allocates by the local and own panel counts
      // typed, so size() counts dfloats: pointInterpolation_t::setPoints takes nPoints = o_px.size(), and the
      // untyped (byte) buffers made find() search 8 N_part points, 7 N_part of them read past the end (tiled8 crash)
      o_xpc = platform->device.malloc<dfloat>(N_part * 3);
      o_f   = platform->device.malloc<dfloat>(N_part * 3);
      o_px  = platform->device.malloc<dfloat>(N_part);
      o_py  = platform->device.malloc<dfloat>(N_part);
      o_pz  = platform->device.malloc<dfloat>(N_part);
      o_upc = platform->device.malloc<dfloat>(N_part * 3);
      o_V   = platform->device.malloc<dfloat>(N_part * 3);
      o_TL  = platform->device.malloc<dfloat>(N_part * 4);
  }

  if (platform->options.getArgs("RESTART FILE NAME").empty()) {
    std::vector<dfloat> U(nrs->meshV->dim * nrs->fluid->fieldOffset, 0.0);
    nrs->fluid->o_U.copyFrom(U.data(), U.size());
  } else {
    restoreForceHistory = true;
  }

  nrs->userSource = &userForcing;
  if (couplingIQN) {
    nrs->preFluid = &ciliaPreFluid;
    nrs->userConvergenceCheck = &ciliaConverged;
  }
  interp = new pointInterpolation_t(nrs->meshV, platform->comm.mpiComm());
  if (N_part > 0) {
    setupBins();
    setupOwnership();
    if (couplingIQN) {   // each rank computes its local cilia (own + halo) and iterates on its own
      setupDeviceKinematics(localCilia);
      setupDistributedIqn();
    }
  }
  fixAlignedAvgNormals();

  dfloat wallArea;
  setupPlaneWeights(wallPlaneZ, o_Wplane, o_WplaneDz, planeArea);
  setupPlaneWeights(0.0, o_Wwall, o_WwallDz, wallArea);
  if (profileCilia) {
    platform->timer.addUserStat("udfSource");
    platform->timer.addUserStat("udfExecuteStep");
    if (rank == 0) printf("cilia: profileCilia = 1 (udf timers with device syncs)\n");
  }

  if (rank == 0) printf("cilia: wall line: plane z = %g (area %.8g), wall z = 0 (area %.8g)\n", wallPlaneZ, planeArea, wallArea);
}

void UDF_ExecuteStep(double time, int tstep) {
  if (!nrs->timeStepConverged) return;   // iqn: nekRS calls this after every corrector

  if (diagInterval > 0 && tstep % diagInterval == 0) {
    ptic("udfExecuteStep::diagnostics");
    printDiagnostics(time);
    if (couplingIQN && (ciliaBinning || binningCheck)) {   // panels outside their footprint (collective check)
      int lost = 0;
      if (kinPanels > 0) o_binLost.copyTo(&lost, 1);
      nekrsCheck(lost != 0, platform->comm.mpiComm(), EXIT_FAILURE,
                 "%d panel positions fell outside their cilium's beat footprint and were not binned\n", lost);
    }
    ptoc("udfExecuteStep::diagnostics");
  }

  // FORCE STEP 0 WRITE FIX:
  // This explicitly creates 3d0.f00000 (with mesh coordinates) at t=0.
  // It fixes the indexing gap and aligns your files with visnek's expectations.
  if (tstep == 0) {
    nrs->copyToNek(time, tstep);
    nek::userchk();
    nrs->writeCheckpoint(time, true); // true = enforce OutXYZ
  } else if (nrs->checkpointStep) {
    nrs->copyToNek(time, tstep);
    nek::userchk();
    if (couplingIQN && nFconv > 0) {   // the converged F and its H live on the device (own panels,
      const size_t n = 3 * nOwnPanels;  // gathered to rank 0 by global id, which writes the restart file)
      std::vector<dfloat> sF(n), sH(n);
      if (n > 0) {
        o_pool.copyTo(sF.data(), n, (size_t)sFconv[0] * n);
        o_pool.copyTo(sH.data(), n, (size_t)sHconv * n);
      }
      const std::vector<dfloat> gF = gatherOwnToRoot(sF, 3), gH = gatherOwnToRoot(sH, 3);
      if (myRank == 0) { f_old = gF; fstar_old = gH; }
    }
    writeForceHistory(time);
  }
}
